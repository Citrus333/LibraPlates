    ['Ulrich']                           = { type = "Mythril Musketeer", icon = "Guard.png", zones = { "Bastok", "Cutscene", "Cutscenes" }, note = "Involved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* Bastok Mission 9-2: Where Two Paths Converge\n\nNotes:\nThe former captain of the Mythril Musketeers and Uncle of Volker. Before the outbreak of the Crystal War he was sent along with two other Mythril Musketeers Raogrimm and Cornelia to investigate the northlands in co-operation with Francmage of San d'Oria and Yow Rabntah and Iru-Kuiru of Windurst. Prior to the expedition Ulrich had been in conflict with Raogrimm because he was advocating peace with the Beastmen, and he was jealous of Raogrimm's relationship with Cornelia." },
    ['Ulrike']                           = { type = "Recipe Giver", icon = "RecipeGiver.png", zones = { "Bastok", "Bastok Markets" } },
