    ['Grav\'iton']                      = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Cutscenes Only" }, note = "Involved in Missions:\n* Zilart Mission 4: The Temple of Uggalepih\n* Windurst Mission 7-2: Awakening of the Gods\n* Promathia Mission 5-2: Desires of Emptiness\n\nNotes:\nOne of the ancient Kuluu, bound in the form of a Tonberry. Her original form is that of an elderly woman." },
    ['Grumblix']                         = { type = "Past Event Watcher NPC", zones = { "Cutscene", "Outland", "See Goblin Footprint" }, note = "Notes:\nIf you come across a Goblin Footprint in the depths of Promyvion, you may hear voices. If so, you can trade any item to the Footprint to have Grumblix will appear and replay cutscenes for you. Any items traded (for example, 1 gil), will not be lost.", info = "If you come across a Goblin Footprint in the depths of Promyvion, you may hear voices. If so, you can trade any item to the Footprint to have Grumblix will appear and replay cutscenes for you. Any items traded (for example, 1 gil), will not be lost." },
    ['Gu\'Zho Thunderblade']            = { type = "Quest Giver", icon = "QuestGiver.png", zones = { "Cutscene", "Oldton Movalpolos" }, note = "Involved in Quests:\n* A Generous General?\n\nNotes:\n* Shieldwarrior Gu'Zho Thunderblade could not accept the leadership of the Adamantking and deserted the Quadav. Now he searches for a new job as a mercenary for the Moblins of Movalpolos." },
