    ['Trisvain']                         = { type = "HTMB Vendor", icon = "Merchant.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\nSells key items required for High-Tier Mission Battlefields. See the Phantom Gems page for individual requirements" },
    ['Uka Totlihn']                      = { type = "Event NPC", icon = "Event.png", zones = { "Northern San d'Oria", "Special Event" } },
    ['Ullegore']                         = { type = "Event NPC", icon = "Event.png", zones = { "Northern San d'Oria", "Special Event" }, note = "Notes:\nleft|180px|thumb|Ullegore's Elvaan form A long, long time ago, on a starry night different from no other, a lone meteorite fell from the bejeweled sky unbeknownst to the slumbering denizens of Vana'diel. From the superheated core of this extraterrestrial rock emerged an entity of unadulterated evil?the physical manifestation of darkness itself. The name of this twisted being was Ullegore. His sole purpose: the complete and utter eradication of joy and jubilance from the face of the world." },
    ['Ulycille']                         = { type = "Smithing Support", icon = "Dialogue.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\n* Gives recipes, and Advanced Synthesis Image Support for Woodworking." },
    ['Vamorcote']                        = { type = "Quest Giver", icon = "QuestGiver.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Starts Quests:\n* The Setting Sun" },
    ['Vavegallet']                       = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\n\"Hrmm... You look like another adventurer obsessed with shining swords and gleaming shields. Am I wrong?\" \"Well, the hallmark of an adventurer is a richly-decorated domicile. Really, you must visit the furniture shop!\"" },
    ['Vichuel']                          = { type = "Regional Vendor", icon = "RegionalVendor.png", zones = { "Northern San d'Oria", "San d'Oria" } },
    ['Villion']                          = { type = "Adventurer's Assistant", icon = "AdventurersAssistant.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Flyers for Regine\n\nNotes:\nOffers Information on the Elemental Relationships:thumb|100px|Elements :Hello there! Through my teachings I seek to raise the awareness of San d'Oria's fine citizens. My specialty is the elements and their correlations. Of course, those from abroad are welcome to my knowledge, too. View the chart of elemental correlations? :*\"Yes.\": [Displays a chart of elemental relationships] Excellent choice, friend. This may not be the best place for study, but let's get started! (Shows a chart of element correlations) Ever heard of the elements, the most primal forms of energy? There are eight in all. Behold, they are like a wheel, with arrows forming a circle. This shows how the myriad elements relate to one another. They are like six serpents in a circle, each biting the tail of the one before it. I will explain simply. Water puts out fire, whilst the heat of fire melts ice. Ice block wind, whilst wind wears away at earth. Can you see it right there? Earth steals energy from lightning, whilst lightning throws its bolts into water. Light and darkness occupy the center. They are in mutual opposition, for one cannot be both at once. Ah, yes! There's one more thing you should know: the elements are tied closely to the status of your health. If you'd like to learn more, I am willing to continue. ::*\"Yes, please.\": Vey good! Fire causes disease, ice paralysis, wind silence, earth petrification, lightning stun, and water poison. Then there is charm, which is caused by light, whilst blindness, curse, and sleep are all the domain of darkness. Therefore, armor and accessories that resist certain elements also help you avoid status ailments caused by those elements. That will be all for today's lecture. Should you wish to review, just ask! I teach all who wish to learn. ::*\"No, that will be enough.\": That will be all for today's lecture. Should you wish to review, just ask! I teach all who wish to learn. :*\"No.\": Ah...that is a shame. You've been taught all you need to know, have you?" },
    ['Yevgeny, I.M.']                    = { type = "Conquest Overseer", icon = "ConquestOverseer.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\n;Notes for characters only with Bastok as current Allegiance: :*Casts Signet :*Recharges Emperor Band, Empress Band or Chariot Band :*Accepts traded Crystals for filling up the Bastok Mission-Rank bar (the red bar at the character's profile) :*Sells items for Conquest Points (Items for Bastok) at certain conditions. It will be also possible to get some items of other Nations (Items for San d'Oria / Items for Windurst) at the guards, if your current Allegiance ranks higher at the weekly Conquest results (for further information see under the items articles) :*Explains the Conquest system by choosing some available questions. ;Notes for characters only without Bastok as current Allegiance: :*Doesn't offer any function For further information see Conquest Overseer." },

