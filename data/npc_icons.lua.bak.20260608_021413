    ['Silver Comet']                     = { type = "Chocobo", icon = "ChocoboRenter.png", zones = { "Cutscene", "Cutscene Only", "Jeuno" }, note = "Involved in Quests:\n* A Chocobo's Tale\n* The Search for Goldmane\n\nNotes:\nThe quests differ on who rode whom, but both Silver Comet and her mate, Shooting Star were the chocobos of the famous bounty hunting duo Goldmane and Cutsilver." },
    ['Siren (NPC)']                      = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Sea Serpent Grotto, Yuhtunga Jungle" }, note = "Involved in Quests:\n* The Silent Forest\n* Winds of Eternity\n\nInvolved in Missions:\n* The Ties that Bind\n* Impurity\n* The Lost Avatar" },
    ['Skokkr Undrborn']                  = { type = "Monstrosity", icon = "GoalTracker.png", zones = { "Cutscene", "Feretory, Leafallia, the Silver Knife" }, note = "Involved in Missions:\n* Skokkr Undrborn's Temptation\n\nNotes:\nIs 'the master' referred to by the Corpselights that guide players to growth within Monstrosity, Vagary battlefields, and ultimately the forging of Prime Weapons. Takes on an alternate form to interact in the mortal realm, Skhoh Undhreh. 300px|Skokkr Undrborn in disguise Gives the player {{KeyItem" },
    ['Sneaking Tiger']                   = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Selbina" }, note = "Involved in Quests:\n* The Tenshodo Showdown\n* Hitting the Marquisate\n\nNotes:\nMember of Atarefaunet's Band" },
    ['Star Sibyl']                       = { type = "Star Sibyl", icon = "Dialogue.png", zones = { "Cutscene", "Heavens Tower, Cutscene only", "Windurst" }, note = "Involved in Missions:\n* Windurst Mission 3-3: A New Journey\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* Windurst Mission 5-1: The Final Seal\n* Windurst Mission 5-2: The Shadow Awaits\n* Windurst Mission 6-2: Saintly Invitation\n* Windurst Mission 7-1: The Sixth Ministry\n* Windurst Mission 9-1: Doll of the Dead\n* Windurst Mission 9-2: Moon Reading\n* A Crystalline Prophecy (Mission)\n\nNotes:\nThe Star Sibyl is the formal name given to the Tarutaru leader of Windurst. She resides in the Vestal Chamber in the Heavens Tower. The current Star Sibyl, has been in power since before the Crystal War. The only ones allowed to see her are her body guards, her vassals, the Ministers of Magic, members of the Parliament of Patriarchs, and high ranking adventurers. She did, however, make one public appearance in the years following the Crystal War, where she urged her people to maintain a peaceful relationship with the Yagudo and to never use Summoning Magic again. She has complete trust in Semih Lafihna, her personal Patriarch Protector. The Star Sibyl is blessed with the ability to read the stars in order to predict future events. She is not a character of many words, yet those words she utters are heartfelt. The Star Sibyl is more than a political leader, she is concidered the physical reincarnation of Altana in the Tarutaru religion. After the current Star Sibyl dies, female children are searched to find her new body and that child is taken and raised by the Heavens Tower nuns. Celibacy is expected of her vassals and, minus government officials, men are kept at a guarded distance from Her Holiness on a day-to-day basis. A notable exception was Karaha-Baruha, an adviser she relied heavily on during the Crystal War whose death struck her especially hard. Her real name may be Miratete, as suggested by the item Miratete's Memoirs. See Also * Tukuku (CE 290-298)" },
    ['Star Sibyl (S)']                   = { type = "Star Sibyl", icon = "Dialogue.png", zones = { "Cutscene", "Heavens Tower, Cutscene only", "Windurst (S)" }, note = "Involved in Quests:\n* The Tigress Strikes\n* The Forbidden Path\n* Howl from the Heavens\n* At Journey's End\n\nNotes:\n* The Star Sibyl is the formal name given to the Tarutaru leader of Windurst. She resides in the Vestal Chamber in the Heavens Tower. *Presents players with the Zodiac Ring in the final cutscene for the quest At Journey's End. *Bequeaths a portion of Windurst to the Mithran Mercenaries in the final cutscene for the quest At Journey's End due to support from Lehko Habhoka and Robel-Akbel's counsel." },
