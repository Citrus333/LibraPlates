    ['Suspicious Elvaan']                = { type = "Monstrosity", icon = "GoalTracker.png", zones = { "Northern San d'Oria" }, note = "Involved in Quests:\n* Monstrosity (Quest)\n* Monstrosity\n\nNotes:\nThis possessed mannequin is controlled by a Corpselight residing in the Feretory. The true form of the possessed mannequin is a corpeslight known as either Maccus, Suibhne, Aengus, or Teyrnon." },
    ['Taulenne']                         = { type = "Armor Depository", icon = "ArmorStorer.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\n* Standing in front of Justi's Furniture in Northern San d'Oria. Stores lvl 24-60 AF, Relic, RSE and other gearsets." },
    ['Taurette']                         = { type = "Riding the Clouds", icon = "QuestNPC.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Riding on the Clouds\n\nNotes:\n* Also a possible in LB4 \"My big brother, he's a Royal Knight. He's off fighting Orcs, far, far away from here.\" \"It's so lonely without him. But someday I'll be a Royal Knight, too, fighting by his side!\" * Described in Riding on the Clouds as, \"A little girl who wants to be a Royal Knight, just like her brother.\"" },
