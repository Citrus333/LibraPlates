    ['Rukususu']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Fei'Yin map=Map 2|F-6 (Behind a locked door, with a golem type mob)", "Windurst" }, note = "Involved in Quests:\n* Curses, Foiled A-Golem!?\n* SMN AF2: Class Reunion\n* SMN AF3: Carbuncle Debacle\n\nInvolved in Missions:\n* Windurst Mission 5-1: The Final Seal\n* Windurst Mission 7-2: Awakening of the Gods\n* Windurst Mission 8-2: The Jester Who'd Be King\n\nNotes:\nRukususu is the Rhinostery minister. She spends much of her time doing field research, particularly concerning the fate of her mentor Iru-Kuiru. In the English version of FFXI, she speaks some French but mostly English with a heavy French accent." },
