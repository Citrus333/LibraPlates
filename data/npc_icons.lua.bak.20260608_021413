    ['Brandolf']                         = { type = "Military Officer", icon = "Dialogue.png", zones = { "Cutscene", "Cutscenes", "Jeuno (S)" }, note = "Involved in Missions:\n* Borne by the Wind (WOTG13)\n* A Nation on the Brink (WOTG14)\n\nNotes:\n* Captain of the Ducal Guard during the Crystal War. *Shares the same unique head model with Maximilian. *Father of Wolfgang" },
    ['Brugaire']                         = { type = "Shipping Industry", icon = "Dialogue.png", zones = { "Cutscene", "Cutscene Only", "Outland" }, note = "Involved in Quests:\n* Chasing Quotas (cutscene only)\n* Souls in Shadow (cutscene only)\n\nNotes:\nInvolved in various aspects of the shipping industry of Vana'diel, including smuggling. Some dock workers and port laborers are known to be indebted to him to make weekly payments; to what end is unknown. Well respected by heads of each of the three nations, as well as in the far-off hidden port town of Norg. It's said, behind closed doors, that he is allowed to continue to run his many operations, both legit and shady, without any checks by city officials so long as he keeps things running 'smoothly' in the ports keeping trade and transportation both efficient and safe." },
