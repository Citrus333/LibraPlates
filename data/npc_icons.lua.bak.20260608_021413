    ['Rugiette']                         = { type = "Riding the Clouds", icon = "QuestNPC.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Riding on the Clouds\n* Lure of the Wildcat (San d'Oria)\n\nNotes:\nDescribed in Riding on the Clouds as, \"A shopkeeper who longs for customers that want more than scrolls of Stone.\"" },
    ['Sheridan']                         = { type = "Riding the Clouds", icon = "QuestNPC.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Riding on the Clouds\n\nNotes:\n* Dialogue: I heard that the Brugaire Consortium that runs these warehouses is looking for workers. They're one of San d'Oria's biggest trading companies...but I hear they're a little rough with their staff. And people say they smuggl--ahem! Wouldn't want a prospective employer to hear me saying that, now would I! * Described in Riding on the Clouds as, \"A young man looking for a job where they're not too rough with him.\"" },
    ['Skipper Moogle']                   = { type = "MHMU worker", icon = "Dialogue.png", zones = { "Port San d'Oria" }, note = "Notes:\n* Explains Mog Gardens and the requirements to access them. *Sells books (in the form of permanent key items) that increase the ranks of specific Mog Garden features. **The same books can be purchased from Zenicca in Western Adoulin at ({{Location Tooltip|area=Western Adoulin|pos=E-9" },
    ['Solgierte']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Notes:\nDialogue: Orcs have been harassing us ever since they took West Ronfaure. Confound those beastmen! But where are the knights? They should have stomped their camps flat months ago, just like in the Great War." },
