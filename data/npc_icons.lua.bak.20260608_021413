    ['Hauh Colphioh']                    = { type = "Guild Points", icon = "GuildworkersUnionRepresentative.png", zones = { "Windurst", "Windurst Woods" }, note = "Notes:\nHauh Colphioh is in charge of the Guildworker's Union for clothcrafting in Windurst. Once you have attained at least level 28 Cloftcraft you may speak with her, and begin accumulating Guild Points for items you turn in. The item requested changes daily, so its important to check back with her to keep track of current time limits, and to find out what new items the guild is accepting." },
