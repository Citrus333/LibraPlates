    ['Machella']                         = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\n\"When I was young, San d'Oria was a beautiful city, where life was pleasant and the days were long.\" \"But now our rulers favor adventurers, drawing mobs of foreigners to town. Oh, my ears burn with their babbling!\"" },
