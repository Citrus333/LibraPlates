    ['Wayward Echo, L.C.']               = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Rolanberry Fields (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok has control of Rolanberry Fields (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Weldon']                           = { type = "Item Deliverer", icon = "ItemDeliverer.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* Item Delivery services will not be available if the city is under attack. \"I am here to help with all your parcel delivery needs.\"" },
    ['Werei (S)']                        = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Cutscene" }, note = "Involved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* Storm on the Horizon\n* Fire in the Hole" },
    ['Werner']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Better Part of Valor\n* Fires of Discontent\n* Light in the Darkness\n* Burden of Suspicion\n\nNotes:\n* Werner was the Senator of Defense for the Republican Army during the Crystal War." },
    ['Wilhelmina']                       = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Quelling The Storm\n\nNotes:\n\"Have you heard the rumors? There have been several sightings of these so-called \"maws\" outside the city. People are saying they may have been unleashed by the beasthordes! All accounts claim that they float just above ground, wreathing about, with gaping mouths like great voids that never shut... It gives me the chills just to think about it.\"" },
    ['Zazarg (S)']                       = { type = "Cohors Commander", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Involved in Quests:\n* The Fighting Fourth\n\nInvolved in Missions:\n* Back to the Beginning (WOTG02)\n* Affairs of State (WOTG12)\n* A Nation on the Brink (WOTG14)\n* Crossroads of Time (WOTG15)\n\nNotes:\n* Pr?fectus of the Seventh Cohors (approx. 360-480 subordinates), of the Republican Legions' Fourth Division." },
