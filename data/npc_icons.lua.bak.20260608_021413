-------------------------------------------------------------------------------
    ['Courisaille']                      = { type = "Quest Associate", zones = { type = "Quest Associate", "Cut scenes only", "Cutscene", "San d'Oria" }, note = "Involved in Quests:\n* |\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite" },
    ['Fickblix']                         = { type = "Goblin Informant", icon = "Dialogue.png", zones = { "Cut scenes only", "Cutscene", "Jeuno" }, note = "Involved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n\nNotes:\nA kindly Goblin living in Jeuno, and a friend of Verena. Despite the animosity toward beastmen, he tries to help improve the community, even helping children grow a flower garden." },
    ['Lion']                             = { type = "Mission", icon = "MissionNPC.png", zones = { "Cut scenes only", "Cutscene", "Norg" }, note = "Involved in Quests:\n* Apocalypse Nigh\n\nInvolved in Missions:\n* San d'Oria Mission 2-3: Journey Abroad\n* Bastok Mission 2-3: The Emissary\n* Windurst Mission 2-3: The Three Kingdoms\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* San d'Oria Mission 5-1: The Ruins of Fei'Yin\n* Bastok Mission 5-1: Darkness Rising\n* Windurst Mission 5-1: The Final Seal\n* San d'Oria Mission 5-2: The Shadow Lord\n* Bastok Mission 5-2: Xarcabard, Land of Truths\n* Windurst Mission 5-2: The Shadow Awaits\n* Zilart Mission 1: The New Frontier\n* Zilart Mission 2: Welcome t'Norg\n* Zilart Mission 8: Return to Delkfutt's Tower\n* Zilart Mission 9: Ro'Maeve\n* Zilart Mission 16: The Celestial Nexus\n* Rhapsodies Mission 1-2-1: The Path Untraveled\n* Rhapsodies Mission 1-2-5: A Land After Time\n* Rhapsodies Mission 3-1-33: Absolute Trust\n* Rhapsodies Mission 3-1-35: A Rhapsody for the Ages\n\nNotes:\nA young woman from the pirate cove of Norg, sent by her father Gilgamesh to investigate the activities of the beastmen and the Grand Duchy." },
    ['Muchavatte']                       = { type = "Former Papsque", icon = "Dialogue.png", zones = { "Cut scenes only", "Cutscene", "San d'Oria" }, note = "Involved in Quests:\n* Undying Flames\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* Promathia Mission 4-3: The Secrets of Worship\n\nNotes:\nMuchavatte P Couchiret is the former papsque of the San d'Orian church. He died of a broken heart after Cardinal Mildaurion, leader of the Tavnavian Cathedral, sabotaged the Temple's attempt to discover the location of the Gate of the Gods during the Crystal War. After telling his close friends \"I was forced to abandon the truth\", he publicly declared the Gate of the Gods was not a physical location but located with the heart shortly before his death, single-handedly reversing thousands of years of dogma. He is buried in the Reliquary. His sussessor's name is Shamonde. |" },
    ['Periduque']                        = { type = "Quest Associate", zones = { type = "Quest Associate", "Cut scenes only", "Cutscene", "San d'Oria" }, note = "Involved in Quests:\n* |\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite" },
    ['Shamonde']                         = { type = "Papsque", icon = "Dialogue.png", zones = { "Cut scenes only", "Cutscene", "San d'Oria" }, note = "Involved in Quests:\n* Her Majesty's Garden\n\nInvolved in Missions:\n* San d'Oria Mission 1-3: Save the Childern\n* San d'Oria Mission 2-2: The Davoi Report\n* San d'Oria Mission 3-2: The Crystal Spring\n* San d'Oria Mission 6-2: Ranperre's Final Rest\n* San d'Oria Mission 7-1: Prestige of the Papsque\n* San d'Oria Mission 8-1: Coming of Age\n* San d'Oria Mission 8-2: Lightbringer\n* San d'Oria Mission 9-1: Breaking Barriers\n* San d'Oria Mission 9-2: The Heir to the Light\n\nNotes:\nThe Papsque is considered by many to be the most pure man in all of San d'Oria. There are many would even like to see him as leader of the entire nation. |" },
    ['Tsiket-Lukit']                     = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cut scenes only", "Cutscene", "Windurst" }, note = "Involved in Quests:\n* The Lost Cardian\n\nNotes:\n\"That's really-willy ridiculous! Cardians are built to fight!\"" },
    ['Verena']                           = { type = "Mission", icon = "MissionNPC.png", zones = { "Cut scenes only", "Cutscene", "Jeuno" }, note = "Involved in Quests:\n* Shadows of the Departed\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* Zilart Mission 8: Return to Delkfutt's Tower\n* Zilart Mission 9: Ro'Maeve\n* Zilart Mission 17: Awakening\n* A Crystalline Prophecy (Mission)\n\nNotes:\nThe younger sister of Aldo, head of the Tenshodo. She has an affinity for the beastmen races and is friends with local Goblins living in Jeuno, especially Fickblix, which creates tension with her brother. However, her natural affinity has also caught the attention of Lord Eald'narche, who became interested in this trait......" },

-------------------------------------------------------------------------------
