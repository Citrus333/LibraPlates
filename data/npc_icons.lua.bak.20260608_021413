    ['Cayu Pensharhumi']                 = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Windurst", "Windurst Woods" }, note = "Involved in Quests:\n* Lure of the Wildcat (Windurst)\n\nNotes:\nDialog: Arrrgh... I'm soo borrred! I wish something would happen to get my hot Mithran blood running again! How I envy adventurerrrs like you. What I'd give to be able to head out into East Sarutabaruta and blow up some balloons forrr a bit of stress relief!" },
