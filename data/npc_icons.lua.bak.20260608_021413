    ['Ace of Batons (S)']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "West Sarutabaruta (S)", "Windurst" }, note = "Notes:\n* Summoned by Zonpa-Zippa during Campaign battles." },
    ['Ace of Coins (S)']                 = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "West Sarutabaruta (S)", "Windurst" }, note = "Notes:\n* Summoned by Zonpa-Zippa during Campaign battles." },
    ['Ace of Cups (S)']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "West Sarutabaruta (S)", "Windurst" }, note = "Notes:\n* Summoned by Zonpa-Zippa during Campaign battles." },
    ['Ace of Swords (S)']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "West Sarutabaruta (S)", "Windurst" }, note = "Notes:\n* Summoned by Zonpa-Zippa during Campaign battles." },
    ['Adventuring Fellow']               = { type = "Citizen", zones = { "Battle" } },
    ['Ajido-Marujido']                   = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Battle", "Cutscene", "Heavens Tower", "Windurst" }, note = "Involved in Quests:\n* I Can Hear a Rainbow\n* Wonder Wands\n\nInvolved in Missions:\n* Windurst Mission 1-1: The Horutoto Ruins Experiment\n* Windurst Mission 2-1: Lost for Words\n* Windurst Mission 3-1: To Each His Own Right\n* Windurst Mission 3-2: Written in the Stars\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* Windurst Mission 6-1: Full Moon Fountain\n* Windurst Mission 8-2: The Jester Who'd Be King\n* Windurst Mission 9-1: Doll of the Dead\n* Windurst Mission 9-2: Moon Reading\n\nNotes:\nBiography: Ajido-Marujido is the \"rogue\" Minister of Windurst's Orastery, the Ministry of Windurst that oversees the use of magic and the training of mages. He is also the son of the creator of the Cardians and the former Minister of the Manustery Zonpa-Zippa, and is the brother of current Manustery Minister Apururu. Although a very powerful mage and a well-respected public figure, he is always getting himself or a random adventurer into trouble in his pursuit for the truth about Windurst and its past. Although labeled as unpredictable and a rogue, he cares deeply about the future of Windurst and its well-being, even more so than his reputation and his political career. He is introduced to us as a \"Child Genius\" student in one of the early Wings of the Goddess missions. Even then he has a flair for getting himself, and you, into trouble. He later becomes one of Shantotto's pupils prior to his role of minister of the Orastery Battle NPC: Ajido-Marujido fights alongside the party during the battlefield event at Full Moon Fountain for Windurst Mission 9-2: Moon Reading. He fights in the second round of the battle, versus Vyala and Tatzlwurm. Ajido-Marujido must be kept alive, because if he falls the battle will be considered a loss; and since he has low HP and grabs enmity very easily with his powerful spells, it's important to keep the heat off him. Ajido can cast all ancient magic, uses both Chainspell and Manafont, teleports around the arena, and has an unusual hand-to-hand attack style similar to Mammets." },
    ['Allied Mantelet']                  = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Battle", "Varies" }, note = "Notes:\n* Constructed in Allied Forces-controlled areas by their respective engineer units (4th Legionnaires, Gold Badger Esquires, and Piscean Casters).{{verification" },
    ['Aquarian Caster']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Various", "Windurst (S)" }, note = "Notes:\n* Leader of the Aquarian Casters is Kayeel-Payeel. *Squadron appears in various locations either fortifying or in Campaign Battles. *They are among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Windurst regains most territory in their cordon. *Constantly recast Blaze Spikes. In battle, will cast various high-level black magic including Poisonga II." },
    ['Aragoneu Knight']                  = { type = "Campaign Knight", icon = "CampaignArbiter.png", zones = { "Battle", "East Ronfaure (S)", "San d'Oria (S)" }, note = "Notes:\nLed by Cerane I Virgaut, the Knights of Aragoneau are, despite their name, deployed only to East Ronfaure." },
    ['Areuhat']                          = { type = "Freelance", icon = "CampaignArbiter.png", zones = { "Battle", "Freelance", "Grauberg (S)" } },
    ['Ariesian Caster']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Garlaige Citadel (S)", "Windurst (S)" }, note = "Notes:\n:*Leader of the Ariesian Casters is Lutete. :*This squadron is only deployed to Garlaige Citadel. |" },
    ['Ashmea B Greinner']                = { type = "Campaign Hero", icon = "TacticalAssessment.png", zones = { "Battle", "San d'Oria (S)", "San d'Oria controlled Batallia Downs (S), Jugner Forest (S), Vunkerl Inlet (S), East Ronfaure (S), The Eldieme Necropolis (S)." }, note = "Involved in Quests:\n* Knot Quite There\n* A Manifest Problem\n\nNotes:\nAppears during Campaign Battles in as the leader of the Scarlet Boar Esquires. *Battle Cry: \"Father! Lend me your strength!\" *Talk: How dare a baseborn peasant raise his/her voice to a noble knight!? Begone, before I strike you down myself! *Uses a unique weapon skill called Prominence. Also uses Sword skills such as Circle Blade and Red Lotus Blade. *Uses Invincible. *Casts Firaga III, Fire IV, Blaze Spikes, Burn, Protect IV, Shell IV and Cure IV. *Has high rate of attack speed. Possibly close to 80-95% haste. This may be due to Dual Wield. *Is able to Double Attack. *May be classified as Paladin / Black Mage with dual wield, due to the fact that she uses PLD's Invincible, Sword weapon skills, and Cure IV, as well as BLM-exclusive Black Magic. She dual wields, but that is the only aspect of NIN that she possesses. *Ashmea and her army can be dispatched to Castle Zvahl Baileys (S) and Castle Zvahl Keep (S) providing the northlands are under Allied control." },
    ['Besieged/Besieged Allies']         = { type = "Citizen", zones = { "Battle" } },
    ['Cantonment']                       = { type = "Campaign Structure", icon = "CampaignArbiter.png", zones = { "Battle", "Yorcia Weald (U)" }, note = "Notes:\n* Must be protected in Yorcia Weald (U) Skirmishes. *Enemies head straight to the cantonment, rather than attacking players." },
    ['Capricornian Caster']              = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "West Sarutabaruta (S)", "Windurst (S)" }, note = "Notes:\n:*Leader of the Capricornian Casters is Zonpa-Zippa. :*This squadron is only deployed to West Sarutabaruta. |" },
    ['Cardian Prototype']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Belfry", "Windurst (S)" }, note = "Notes:\n* Spawned by an Allied Armored Belfry erected by the Federal Forces of Windurst. Participates in offensive Campaign Battles. A maximum of 5 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter." },
    ['Cerane I Virgaut']                 = { type = "Campaign Leader", icon = "TacticalAssessment.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Notes:\n* Appears in Campaign Battles as the leader of the Aragoneu Knights. *Wields Aegis, and does very large damage with Shield Bash, Up to 2000 points of damage. *Casts Protect IV, Shell IV, Cure IV, Stoneskin and Phalanx. *Uses Invincible. *Is able to Double Attack. *Her HP appears to never fall during battle. She rarely takes more than 20~ points of damage due to her near constant shield blocking. *Wields a Morgenstern, Uses Hexa Strike (between 900-1400+ points of damage), Black Halo, Judgment and True Strike. * Battle Cry: Ha hah! Your arrows cannot pierce the iron will of a true knight! - tends to say this only when she uses Invincible. * Talk: It is often in times of strife that a man's true nature is revealed. Will you stand tall in the face of fear, or run and cower in the wake of your mother's dress?" },
    ['Choh Moui']                        = { type = "Citizen", zones = { "Battle", "Crawlers' Nest (S)", "Freelance" } },
    ['Cobra Mercenary']                  = { type = "Campaign Ally", icon = "CampaignArbiter.png", zones = { "Battle", "Ghoyu's Reverie, Everbloom Hollow", "Windurst (S)" }, note = "Involved in Quests:\n* A Feast for Gnats\n\nInvolved in Missions:\n* A Nation on the Brink (WOTG14)\n\nNotes:\n* Fights alongside Romaa Mihgo during the quest A Feast for Gnats and the mission A Nation on the Brink." },
    ['Combat Salvemixer']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S), West Sarutabaruta (S), Fort Karugo-Narugo (S), Meriphataud Mountains (S), Garlaige Citadel (S), Sauromugue Champaign (S)" }, note = "Notes:\n:*Appears in Campaign battles along with another dispatched unit (except the Piscean Casters) in areas under Windurst's control; they never appear as a standalone unit. :*They will cast Blink, Phalanx, Stoneskin, Raise, and up to Protect IV, Shell IV, and Cure V on Campaign NPCs, anyone with Allied Tags on, and Beastmaster pets. Their spells seem to be on a timer, similar to Pixies. ::*The selection of spells they'll cast is dependent on conditions of the Federal Forces of Windurst. Their capabilities can be augmented by doing the Cut and Cauterize (W) campaign ops. :*They will not attack unless attacked. When attacked, they will engage the aggressor. This will often happen in battles with monsters that use AoE attacks. :*Salvemixers have a finite MP pool and will rest/heal to regain MP. They have low defense and HP compared to other Federal Force units, but a greater MP pool. :*In the event that the unit they arrived with retreats, they will remain on the battlefield and not retreat, remaining to assist anyone nearby and to fight if attacked. :*They use an ability called Goddess's Shield; this enables them to cast self-targeting spells like Blink and Phalanx on allied targets." },
    ['Cougar Volunteer']                 = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Meriphataud Mountains (S)", "Windurst (S)" }, note = "Notes:\n:*Appears during Campaign Battles as part of the Cougar Volunteer squadron, led by Mikhe Aryohcha :*This squadron is deployed only to Meriphataud Mountains." },
    ['Crocodile Mercenary']              = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Sauromugue Champaign (S)", "Windurst (S)" }, note = "Notes:\n:*Appears during Campaign Battles as part of the Crocodile Mercenary squadron, led by Vhino Delkahngo. :*This squadron is only deployed to Sauromugue Champaign." },
    ['Dalzakk (S)']                      = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Battle", "Freelance", "Sauromugue Champaign (S) (wandering)" }, note = "Notes:\n*  Dalzakk appears in the present during various cutscenes. * Battle Cry: Hiiiiii-yah! * Uses a powerful One Inch Punch every few seconds instead of meleeing. * When near defeat, Oggbi may appear and assist him. Maruna-Kurina's Notes: Ahhh, the wandering monk, said to have been trained in hand-to-hand combat by the legendary-wary Oggbi himself. He's known far and wide for his adventures and exploitarus. He can be seen running about Sauromugue Champaign as part of his daily regimen. He's a sucker for high morale, and can barely contain himself once the conversation-wation turns to the topic of war. They say battle fever is contagious, you know. And he's always willing to talk it up with a fellow monk. A powerful ally, indeed. Keep an eye on the heroism gauge with this one. He's an animal! How to Influence: *Talk to him with Monk as your main job. \"As you can see, I still have many malms to tread before my training is complete. Perhaps one day our paths will cross again on the fields of battle. Until then, friend.\" When Allied: \"I have rested long enough. It is time for me to make my master proud.\" \"Fear not. My fists will guide us to victory.\" *When allied with San d'Oria, Dalzakk roams Victory Square and Pikeman's Way in Southern San d'Oria (S). *When allied with Bastok, Dalzakk roams the area near the Rye Bridge in Bastok Markets (S). *When allied with Windurst, Dalzakk roams Huntsman's Court in Windurst Waters (S)." },
    ['Darrcuiln']                        = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Battle", "Cutscene", "East Ulbuka Territory", "Outland" }, note = "Involved in Missions:\n* Kumhau, the Flashfrost Naakual\n* Soul Siphon\n* Salvation" },
    ['Degenhard (S)']                    = { type = "Campaign Freelance", icon = "CampaignArbiter.png", zones = { "Battle", "Campaign battle only", "Freelance" }, note = "Involved in Quests:\n* None\n* Notes:\n* Sometimes shows up to help out Maat during campaign battles.\n* Uses the unique weapon skill Rising Dragon." },
    ['Febrenard C Brunnaut']             = { type = "Casts Cure V on himself.", icon = "Dialogue.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S) or The Eldieme Necropolis (S)" }, note = "Notes:\n* Appears in campaign battles, as commander of the Temple Knights. *Spams Holy and Banish III when engaged in battle. *Possesses an innate and powerful Enlight effect on his melee attacks. *Uses various Sword weaponskills, and Shield Bash which does very high damage. **Febrenard seems to favor using Shining Blade and Seraph Blade. *Battle Cry: Altana! Let your divine light guide us to victory! *Casts Protectra V and Shellra V on himself, which will carry over to nearby players. *Casts Cure V on himself." },
    ['Federation Dispenser']             = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Varies", "Windurst (S)" }, note = "Notes:\n* Appears during an offensive campaign against Beastman territories. Up to 3 dispensers may be present at a time. *Distributes temporary items to players allied with Windurst in the battle. *Upon the depletion of their stock, these distributors will temporarily return to headquarters in order to replenish their stores. *They will take defensive action against aggressors, but during that time they will be unable to dispense items. Should they become incapacitated in the course of battle, a replacement will be dispatched after a certain amount of time has elapsed. *Item availability and quantity is directly influenced by each nation's skill and production levels." },
    ['Federation Garrison']              = { type = "Battle", icon = "Dialogue.png", zones = { "Battle", "Ghoyu's Reverie", "Windurst" }, note = "Involved in Missions:\n* Granite Rose I (Windurst)\n* Granite Rose II (Windurst)" },
    ['Federation Infantry']              = { type = "Battle", icon = "Dialogue.png", zones = { "Battle", "Ghoyu's Reverie", "Windurst" }, note = "Involved in Missions:\n* Brave Dawn I (Windurst)\n* Brave Dawn II (Windurst)\n\nNotes:\n* Weapon changes depending on mission, but always has /WHM and casts Cure III on self." },
    ['Feldrautte I Rouhent']             = { type = "Battle Cry.", icon = "Dialogue.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Notes:\nAppears during Campaign Battles as the leader of the Norvallen Knights. Appears to be a Staff-wielding Paladin/Monk, as he has been seen using Counterstance. *Talk: \"The kingdom's defeat at Jugner still stings. To avenge the souls of those lost on that fateful day, we must join hands and take up arms as one.\" *Feldrautte has extremely high HP and attack strength. *Feldrautte often counters enemy hits with his own. *Uses Counterstance to increase his counter rate. *Casts Protect IV, Shell IV and Cure IV. *Uses Invincible *Often uses the weaponskill Full Swing, dealing extreme damage. Does use other weaponskills. *Battle Cry: \"For the king!\"" },
    ['Gariri']                           = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* Howl from the Heavens\n\nNotes:\n:*Appears during Campaign Battles as the leader of the Scorpion Casters. :*Gariri is among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Windurst regains most territory in their cordon. :*Summons a Flame Giant (Ifrit avatar) to fight alongside her. Use Astral Flow when her HP falls below 50%. :*Casts high level area of effect and single target fire based spells. :*Taking part in Campaign Battles, Gariri will frequently be found in differing locations. While not out by Campaign Fortifications, she will be found in Windurst Waters (S). :*Talk: Ah, the Fates have brought you to Gariri the Magnificent! Why am I thus called, you ask? Why, because only I was magnificent enough to decryptify those mysteriously marvelous Near eastern tomes and open a window to...the Other Side! :*Battle cry: There is nothing more magnificent than the dance of flames on the battlefield!" },
    ['Gessho']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Battle", "Cutscene", "Far East", "Various cutscenes" }, note = "Involved in Quests:\n* Divine Interference\n\nStarts Missions:\n* Aht Urhgan Mission 16: Ghosts of the Past\n* Aht Urhgan Mission 36: Gaze of the Saboteur\n\nInvolved in Missions:\n* Aht Urhgan Mission 4: Knight of Gold\n* Aht Urhgan Mission 7: Westerly Winds\n* Aht Urhgan Mission 15: The Black Coffin\n* Aht Urhgan Mission 18: Passing Glory\n* Aht Urhgan Mission 19: Sweets for the Soul\n* Aht Urhgan Mission 28: Bastion of Knowledge\n* Aht Urhgan Mission 29: Puppet in Peril\n* Aht Urhgan Mission 35: Legacy of the Lost\n* Aht Urhgan Mission 47: The Empress Crowned\n\nNotes:\n* A wayward Yagudo employed as a mercenary of Salaheem's Sentinels." },
    ['Haja Zhwan']                       = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* When One Man Is Not Enough\n\nNotes:\n* Appears during Campaign Battles as the leader of the Wildcat Volunteers. *Taking part in Campaign Battles, Haja Zhwan will frequently be found in differing locations. While not out by Campaign Fortifications, she will be found in Windurst Waters (S) by the entrance. *Uses both Detonator and her signature Bloody Quarrel weaponskill. * Talk: If only the Parliament of Patriarchs would loosen the strings on their purses a little more, I would be outside right now roasting up a couple birdmen to snack on! * Battle Cry: Time to go to work!" },
    ['Iroha']                            = { type = "Mission", icon = "MissionNPC.png", zones = { "Battle", "Cutscene", "Far East" }, note = "Involved in Missions:\n* Rhapsodies of Vana'diel Missions\n\nNotes:\n* Wields powerful fire magic such as Flare II. *She is the future 14-year-old daughter of Tenzen and Kagero. *She eventually becomes the host for the reincarnated Phoenix." },
    ['Iron Ram Knight']                  = { type = "Campaign Ally", icon = "CampaignArbiter.png", zones = { "Battle", "Everbloom Hollow", "San d'Oria (S)" }, note = "Involved in Missions:\n* A Nation on the Brink (WOTG14)\n\nNotes:\n* Fights alongside Rongelouts N Distaud during the mission A Nation on the Brink." },
    ['Kagetora (S)']                     = { type = "Campaign NPC", icon = "CampaignArbiter.png", zones = { "Battle", "Freelance", "Varies: Batallia Downs (S)" }, note = "Notes:\n* If independent, he will remain in one of the three above zones, he will not change his location until a tally is done. If a Campaign battle is in progress, he will disappear until it is over. *Battles with Utsusemi \"clones\" of himself. *Battle Cry: I saved this one especially for you! *This NPC appears in the present as Kagetora and can be found at Port Bastok (F-6) - Upper level of Warehouse 2. \"I don't have time to entertain the likes of you. Get out of my face.\" Maruna-Kurina's Notes: A Hume pirate-wirate hailing from Elshimo Island, Kagetora has made quite the name for himself. He comes from a long family line of ninjas, and rumor has it he sailed to these western lands in hot pursuitaru of a sworn enemy. Not the most social chap at the party, but he does have profitable ties to the Tenshodo in Jeuno. A ninja with a ninja's pleasures, try to warm him up to you by giving him a shuriken. How to Influence: *Trade him shurikens to gain influence for your allegiance. You can only trade him one at a time, zoning between trades. \"Hmmph...I'll consider remaining with your (kingdom/republic/federation), but I won't make you any gurantees. Hold on... You haven't happened to hear anything about an Ensetsu, have you? His family's supposed to be living here in Bastok. Ah, nevermind. Forget you heard anything from me.\" When Allied: *Appears at (D-6) in Southern San d'Oria (S) when he affiliates with San d'Oria. *Appears at (G-4) in Bastok Markets (S) when he affiliates with Bastok. *Appears at (J-6) in Windurst Waters (S) when he affiliates with Windurst." },
    ['Kayeel-Payeel (S)']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* Howl from the Heavens\n\nNotes:\n* Appears during Campaign Battles as the leader of the Aquarian Casters. *Taking part in Campaign Battles, Kayeel-Payeel will frequently be found in differing locations. While not out by Campaign Fortifications, he will be found in Windurst Waters (S). *Kayeel-Payeel is among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Windurst regains most territory in their cordon. *In Campaign Battles, he is a BLM/SMN wearing a full Cobra Unit Robe Set and wielding a Claustrum. *Has access to all Staff Weapon Skills including Gate of Tartarus *Assisted by an Ice Fiend and Thunder Fiend after a certain amount of time has elapsed, will summon the Ice Fiend first and then the Thunder Fiend, The elementals will mimic all of his spells. *Uses Manafont. *Has access to all BLM spells including Ancient Magic II with devastating damage (upwards of 2000HP) :* Has an incredibly potent Fast Cast effect when casting all his spells, his elementals also share this trait. *Uses a weaponskill called Tartarus Torpor which inflicts AoE sleep, Magic Evasion Down and Magic Defense Down. :* Players may gain access to Tartarus Torpor during Campaign Battles with a Samudra Equipped. * Battle Cry: The gates to the underworld have opened! I?ll see you on the other side?or not! Wahahahahah! * As a mercenary while waiting for a Campaign battle to start, talk to him and he says: Oh, whatever has become of my sweet Windurst? Rabble running through the streets, streets overrun with rabble! Why are you even speaking to me!? Does the title Master Caster no longer garner even an onze of respect!?" },
    ['Kilhwch']                          = { type = "Campaign Freelance", icon = "CampaignArbiter.png", zones = { "Battle", "Freelance", "Varies" }, note = "Involved in Quests:\n* Relic Weapon: Excalibur\n\nNotes:\n\"I advise you distance yourself from Lady Ulla. I know not your intentions, but I am inclined to believe they are crooked.\" \"Her father and I implored the Lady Ulla to remain within the confines of the estate, but our pleas fell on the deaf ears of youth, and thus I am here to ensure nothing unfortunate befalls her ladyship.\" *Fights alongside Ulla. *Wields Excalibur, and uses Knights of Round. *When Ulla yells \"Kilhwch, silence these fiends!\", Kilhwch may cast Silence on his current target. *Will cast Cure V on Ulla when he says: \"Lady Ulla, we must retreat.\" *If Ulla is taken out in battle, Kilhwch will scream \"How dare you!\" and proceed to use Invincible and go on an all-out offensive. *When allied with the Kingdom of San d'Oria Kilhwch will assist in battle at Jugner Forest (S). *When allied with the Kingdom of San d'Oria, Ulla and Kilhwch can be found at (G-10) of Southern San d'Oria (S). *When allied with the Federal Forces of Windurst, Kilhwch will assist in battle in the Sarutabaruta Front. *When allied with the Federal Forces of Windurst, Ulla and Kilhwch can be found at (F-7) of Windurst Waters (S). *When allied with the Republic of Bastok, Kilhwch will assist in battle at Grauberg (S) and Pashhow Marshlands (S). *When allied with the Republic of Bastok, Kilhwch can be found at D-11 in Bastok Markets (S). *When unallied, Kilhwch and Ulla can be found at (G-10) of Southern San d'Oria (S)." },
    ['Laisavie X Berlends']              = { type = "Battle Cry.", icon = "Dialogue.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Notes:\n* Appears during Campaign Battles in Jugner Forest (S) and Southern San d'Oria (S) as the leader of the Silver Fox Archers. She is a Paladin/Ranger. *Has a unique ranged weaponskill: Arrow of Apathy which deals conal damage and Paralyze to enemies in range. *Uses Invincible. *Casts Protect IV, Shell IV and Cure IV. *Uses Barrage to weaponskill back to back; often uses her battle cry before doing so. *When in melee range may use Sword WS's such as Vorpal Blade and Savage Blade *Battle Cry: \"This arrow to your heart shall be Altana's final judgement.\"" },
    ['Lebros Apkallu']                   = { type = "Mission Ally", icon = "MissionNPC.png", zones = { "Battle", "Lebros Cavern", "Outland" }, note = "Involved in Missions:\n* Apkallu Breeding\n* Egg Conservation\n\nNotes:\nA large number of these apkallu fight alongside players in the mission Egg Conservation." },
    ['Lehko Habhoka']                    = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Battle", "Cutscene", "Windurst (S)", "Windurst Waters (S) (Cutscenes Only)" }, note = "Involved in Quests:\n* Knot Quite There\n* A Manifest Problem\n* When One Man Is Not Enough\n* A Feast for Gnats\n* The Long March North\n* The Forbidden Path\n* Sins of the Mothers\n* Howl from the Heavens\n* Manifest Destiny\n* At Journey's End\n\nInvolved in Missions:\n* Affairs of State\n\nNotes:\n* A rare sight in the Middle Lands, this Mithra gentleman serves as Robel-Akbel's tactical adviser." },
    ['Leonoyne']                         = { type = "Flavor NPC", icon = "Dialogue.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Notes:\n* Commands the Savage Hound Condotties, an all female unit that appear to be Dark Knights. *Leonoyne is among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once San d'Oria regains most territory in their cordon. *Can use Invincible. *Wields the Bahadur, mainly uses the weaponskills Frostbite, Freezebite and Spinning Slash, as well as a unique cone AoE weapon skill, Spine Chiller, that will inflict damage and Terror all mobs in front of him when he is below 50% health. *Casts Cure IV, Protect IV, Shell IV (Only on himself), Blizzaga III, Blizzard IV, Ice Spikes and Frost. *Melee attacks have additional effect: ice damage on every hit. *Can intimidate undead. *When spoken to normally: \"Hah hah hah! The ringing of steel upon steel! The dripping stench of the battlefield! What could be better than war? The nobles can have their balls; I'll do my dance on the front lines!\" *Battle Cry: \"Gwahahaha! Let me cool you off a little before I send you to hell!\" *May be considered a Paladin/Black Mage, as he uses a Great Sword and high tier Black Magic, but despite his appearance he has no uniquely Dark Knight skills. *His name, personality and background (holding off a huge beastman army at the Battle of Jugner with 300 men) may be a reference to Leonidas of the film 300 and the Battle of Thermopylae." },
    ['Lewenhart (S)']                    = { type = "Freelance", icon = "CampaignArbiter.png", zones = { "Battle", "Freelance", "The Eldieme Necropolis (S) Notes: *Goes around bestowing Bard song effects on campaign participants. This is usually heralded by him singing a random verse. *Provides buffs to any players within range during battle, such as Mage's Ballad II and Army's Paeon V. *Only engages in melee when attacked. *Has been observed casting the following when engaged: Carnage Elegy, Horde Lullaby, Magic Finale *His songs WILL Hit Player pets. Maruna-Kurina's Notes: Lewenhart is a traveling-waveling bard who has become a favorite amongst the troops, instilling hope and courage with his singing. It turns out that almostaru nothing helps morale as a much as a good song. They say he prefers to stay close to a certain tomb in The Eldieme Necropolis, where his requiems can be heard far and wide. He often asks for holy water as payment for his songs, which he puts to cermonial-wonial use. And as with most musicians, he loves exchanging in song and banter with fellow bards. How to Influence: *Trade him Holy Water. *Talk to him as a Bard Quotes: *\"Oh, how I long for the days of peace when I was free to roam from tavern and wherever else my heart led me.\" *\"Loyal children of Altana, arise and be sustained. Be nourished in thine undying faith, and bask in victory's refrain.\" = Mage's Ballad or Mage's Ballad II *\"O gentle Goddess of the Dawn, thou brighten the black of night. Hear our song and heed our call, and bathe us in your delight.\" = Army's Paeon IV or Army's Paeon V *\"Sing! Dance! Laugh , and cry! Let sweat rain down in floods! Ride upon this rhythmic beat, make seethe thy red life blood.\" = Dragonfoe Mambo *\"Press forward valiant soldiers, glory draws nearer still. Thy deeds shall resound forever, by my stirring song fulfilled.\" = Victory March When Allied: *Can be found at" } },
    ['Lhu Mhakaracca']                   = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* When One Man Is Not Enough\n\nNotes:\n:*Appears during Campaign Battles as the leader of the Python Mercenaries. :*Calls upon Kyo and Pya, which are Rocs. :*Taking part in Campaign Battles, Lhu Mhakracca will frequently be found in differing locations. While not out by Campaign Fortifications, she will be found in Windurst Waters (S). :*Owns a Guttler. Unlike most relic weapons that seem to keep their intelligence a secret, Lhu's Guttler speaks publicly, much to her annoyance. :*Talk: (Guttler! I told you to keep qui--) Ahahahah... Don't mind me, I was just...uh...keeping myself company! (Shhh! If you open your mouth one more ti--) Ahahaha... Uh, were you still there? :*Guttler's battle cry: Guttler thirsty! Guttler want blood! More blood! (It says this right before Lhu uses Onslaught)" },
    ['Libran Caster']                    = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Various", "Windurst (S)" }, note = "Notes:\n:*Leader of the Libran Casters is Zolku-Azolku. :*Squadron appears in various locations either fortifying or in Campaign Battles. :*Buffs themselves with Protect IV and Shell III." },
    ['Luminous Coalescence']             = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S), Garlaige Citadel (S)" }, note = "Notes:\n* Summoned by Lutete during Campaign Battles (up to 4 {{PAGENAME" },
    ['Lutete']                           = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* Howl from the Heavens\n\nNotes:\n* Appears during Campaign Battles as the leader of the Ariesian Casters. *Lutete and her caster company will only engage in campaign battles at Garlaige Citadel (S) and Windurst Waters (S). *Summons three Luminous Coalescences that fight alongside her. *Casts Curaga IV on herself and her Luminous Coalescences. *Use the weapon skill Moonlight to restore the MP of her elementals. *Talk: ... Mastering these Near Eastern magics can be quite taxing. If I had a choice, I'd rather be back in bed, relaxing... *Battle cry: ... Um... Holy light... show the way...?" },
    ['Mieuseloir B Enchelles']           = { type = "Campaign Hero", icon = "TacticalAssessment.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Notes:\nAppears during offensive Campaign Battles as the leader of the Crimson Wolf Esquires. *Mieuseloir appears to be a Dark Knight/Paladin, who wields Ragnarok. **Melee attacks have a constant Endrain, sapping between 50-100 HP from his enemies. **Has access to Black Magic: Aspir, Drain, all Absorb- spells, Stun and Dread Spikes. **Has access to White Magic: Protect IV, Shell IV, Holy, Banish III and Cure IV. **Uses all Sword WS's including Savage Blade. ***Uses the unique weapon skill Cruel Riposte, which drains an enormous amount of HP from his enemy. **Uses Blood Weapon. **Uses Shield Bash. *Mieuseloir appears several times in the Vana'diel Tribune in the stories of Joseaneaut's Mission. He is referred to as the leader of the \"Red Wolves\" in A Heroic Gigas, which undoubtedly is the same as the Crimson Wolves of the Crystal War." },
    ['Mikhe Aryohcha']                   = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* When One Man Is Not Enough\n\nNotes:\n* Appears during Campaign Battles as the leader of the Cougar Volunteers. *Her mercenary company deploys only to Meriphataud Mountains (S) and Windurst Waters (S). *Uses various Hand-to-Hand weapon skills, including her unique Leonine Legflail. *Talk: Do you like the headpiece? I made it from my firrrst victim. I wear it to let everrryone know what happens when they cross Mikhe Aryohcha! *Battle cry: (Snorrre) ....is that the best you can do?" },
    ['Moogle (NM)']                      = { type = "Citizen", zones = { "Battle" } },
    ['Noble Warrior']                    = { type = "Battle", icon = "Dialogue.png", zones = { "Battle", "Cirdas Caverns (U)", "Outland" }, note = "Notes:\n* Assists the player in The Gates. *Uses Into the Light, 12 Blades of Remorse, Vehement Resolution, Camaraderie of the Crevasse, and Arduous Decision. *His true identity is Morimar." },
    ['Noillurie']                        = { type = "Royal Knight", icon = "Guard.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Involved in Missions:\n* WOTG16: Sandswept Memories\n* WOTG20: On Thin Ice\n* WOTG21: Proof of Valor\n* WOTG22: A Sanguinary Prelude\n* WOTG25: The Will of the World\n\nNotes:\n*  Leader of the Knights of the Red Rose. Noillurie and her knights only engage in campaign battles at Vunkerl Inlet (S) and Southern San d'Oria (S). *Wields Amanomurakumo, and uses Tachi: Kaiten, as well as all other Great Katana weapon skills. *After using Meikyo Shisui, she will use every single Great Katana weapon skill back to back in order from Enpi to Kaiten. *Can use Meikyo Shisui several times in a battle. *Casts: Protect IV, Shell IV and Cure IV *Battle Cry: ::Shogyo Mujo! ????? ::Zesho Meppo! ????? ::Shometsu Metsui! ????? ::Jakumetsu Iraku! ????? :*Roughly translates to: \"All phenomenon is impermanent! All that arises becomes extinguished! The end of arising and ceasing! The bliss of nirvana!\" *Quote: After years of training in the Far East, I return only to find my nation burning at the hands of the infernal beastmen hordes. The heathens shall pay dearly... My work has only just begun." },
    ['Norvallen Knight']                 = { type = "Campaign Knight", icon = "CampaignArbiter.png", zones = { "Battle", "Jugner Forest (S)", "San d'Oria (S)" }, note = "Notes:\nAppears during Campaign Battles following Feldrautte I Rouhent." },
    ['Nyumomo']                          = { type = "Battle cry.", icon = "Dialogue.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Notes:\n* Appears during Campaign Battles as the leader of the Patriarch Protectors. Deployed only to Fort Karugo-Narugo (S) and Windurst Waters (S). *Nyumomo casts high tier earth elemental magic. *Calls forth Patrol Worms when engaged in combat. *Talk: Normally, it is my duty to protect the patriarchs of parliament, but with the fate of Windurst in doubt, I'm forced to lead my loyal pets to the front lines. *Battle cry: You, over there. No, wait! You're supposed to be on that side! Hold on, which one were you again? Arrrghh!" },
    ['Odzmanouk']                        = { type = "Freelance", icon = "CampaignArbiter.png", zones = { "Battle", "Campaign battles", "Freelance" }, note = "Notes:\n* Transformed version of Areuhat in battle. Players that complete the Areuhat quest ?Beast from the East? can subsequently trade to a Scouted Areuhat a Shell Bug, and cause her to take flight as Odzmanouk during Campaign Battles. *Primarily uses Hurricane Wing on surrounding opponents. Also uses Spike Flail on opponents behind her." },
    ['Oggbi (S)']                        = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Battle", "Campaign battles", "Freelance" }, note = "Notes:\n* Sometimes appears to bail out Dalzakk if he's losing in campaign battles." },
    ['Patriarch Protector']              = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Fort Karugo-Narugo (S) and Windurst Waters (S)", "Windurst (S)" }, note = "Notes:\n* Leader of the Patriarch Protectors is Nyumomo. They are responsible for Fort Karugo-Narugo." },
    ['Prishe']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Battle", "Cutscene", "Tavnazian Safehold" }, note = "Involved in Quests:\n* Storms of Fate\n* Apocalypse Nigh\n* VW Op. 026: Tavnazian Terrors\n* VW Op. 004: Bibiki Bombardment\n* A Chocobo's Tale\n* In the Mood for Love\n* Hook, Line, and Sinker\n\nInvolved in Missions:\n* Promathia Mission 2-3: Distant Beliefs\n* Promathia Mission 2-4: An Eternal Melody\n* Promathia Mission 2-5: Ancient Vows\n* Promathia Mission 3-1: Call of the Wyrmking\n* Promathia Mission 3-2: Vessel Without a Captain\n* Promathia Mission 3-5: Darkness Named\n* Promathia Mission 4-1: Sheltering Doubt\n* Promathia Mission 4-3: The Secrets of Worship\n* Promathia Mission 4-4: Slanderous Utterings\n* Promathia Mission 5-1: The Enduring Tumult of War\n* Promathia Mission 5-2: Desires of Emptiness\n* Promathia Mission 5-3: Three Paths\n* Where Messengers Gather (Ulmia's Path)\n* Promathia Mission 6-1: For Whom the Verse is Sung\n* Promathia Mission 6-3: More Questions Than Answers\n* Promathia Mission 6-4: One to be Feared\n* Promathia Mission 7-1: Chains and Bonds\n* Promathia Mission 7-2: Flames in the Darkness\n* Promathia Mission 7-3: Fire in the Eyes of Men\n* Promathia Mission 7-4: Calm Before the Storm\n* Promathia Mission 7-5: The Warrior's Path\n* Promathia Mission 8-2: A Fate Decided\n* Promathia Mission 8-3: When Angels Fall\n* Promathia Mission 8-4: Dawn\n\nNotes:\nA girl once referred to as \"that detestable child\" or \"the abhorrent one.\" She was raised by the cardinal and schooled in the ways of theology. Acts as head of Tavnazia Safehold's patrol guards and has a habit of swearing. [http://finalfantasy.wikia.com/wiki/Dissidia_012_Final_Fantasy Dissidia 012] 90px|right [http://finalfantasy.wikia.com/wiki/Prishe/Dissidia Prishe Dissidia Profile] Prishe appears as a playable secret character in Dissidia 012. She is allied with Cosmos, the Goddess of Harmony and is voiced by Aya Hirano in the Japanese version, and Julie Nathanson the English version. Prishe's role in the game is small, but she is responsible for recruiting Warrior of Light to the side of Cosmos." },
    ['Red Rose Condottiere']             = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "San d'Oria (S)", "Vunkerl Inlet (S)" }, note = "Notes:\n*  Appears during Campaign Battles as part of the Knights of the Red Rose squadron, under the command of the Samurai Noillurie. They are only deployed to Vunkerl Inlet (S) * Like their Savage Hound Condottie counterparts they are an all female unit. * Although they wear several Dark Knight only pieces of armor they have not been observed to use any form of magic. * Though they use great axes, they seem to be samurai like their commander, as they possess the Demon Killer trait." },
    ['Romaa Mihgo (S)']                  = { type = "Cobra Commander", icon = "Dialogue.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* The Tigress Stirs\n* The Tigress Strikes\n* Knot Quite There\n* A Manifest Problem\n* When One Man Is Not Enough\n* A Feast for Gnats\n* The Long March North\n* Sins of the Mothers\n* Howl from the Heavens\n* At Journey's End\n\nInvolved in Missions:\n* WOTG02: Back to the Beginning\n* WOTG14: A Nation on the Brink\n* WOTG15: Crossroads of Time\n\nNotes:\n* Leader of the Cobra Unit of the Mithra Mercenaries during the Crystal War. Presents medals awarded to adventurers aligned with her Cobra Unit after successful evaluations." },
    ['Rongelouts N Distaud (S)']         = { type = "Iron Ram Commander", icon = "Dialogue.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Involved in Quests:\n* Steamed Rams\n* Gifts of the Griffon\n* Perils of the Griffon\n* In a Haze of Glory\n* The Price of Valor\n* Bonds That Never Die\n* Chasing Shadows\n\nInvolved in Missions:\n* WOTG02: Back to the Beginning\n* WOTG14: A Nation on the Brink\n* WOTG15: Crossroads of Time\n* WOTG21: Proof of Valor\n\nNotes:\nLeader of the Knights of the Iron Ram during the Crystal War. Presents medals awarded to adventurers aligned with his order after successful evaluations." },
    ['Royal Banneret']                   = { type = "Royal Guard", icon = "Guard.png", zones = { "Battle", "Belfry", "San d'Oria (S)" }, note = "Notes:\n* Spawned by an Allied Belfry erected by the Royal Army of San d'Oria. Participates in offensive Campaign Battles. A maximum of 5 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter." },
    ['Royal Esquire']                    = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Belfry", "San d'Oria (S)" }, note = "Notes:\n* Spawned by an Allied Armored Belfry erected by the Royal Army of San d'Oria. Participates in offensive Campaign Battles. A maximum of 5 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter." },
    ['Royal Guard']                      = { type = "Royal Guard", icon = "Guard.png", zones = { "Battle", "East Ronfaure (S)", "San d'Oria (S)" }, note = "Notes:\n* Under the command of General Valaineral R Davilles. *They are among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once San d'Oria regains most territory in their cordon." },
    ['Royal Knight']                     = { type = "Campaign Knight", icon = "CampaignArbiter.png", zones = { "Battle", "Jugner Forest (S), East Ronfaure (S), Batallia Downs (S).", "San d'Oria (S)" }, note = "Notes:\n* Utilizes Weapon Skills: Fast Blade, Circle Blade, Shining Blade, Red Lotus Blade (Possibly others yet to be observed.). *Utilizes Spells: Banish II (Possibly others yet to be observed.)." },
    ['Royal Palliator']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "San d'Oria (S)", "Southern San d'Oria (S), East Ronfaure (S), Jugner Forest (S), Vunkerl Inlet (S), The Eldieme Necropolis (S), Batallia Downs (S)" }, note = "Notes:\n* Appears in Campaign battles along with another dispatched unit (except the Gold Badger Esquire) in areas under San d'Orian control; they never appear as a standalone unit. *They will cast Blink, Phalanx, Stoneskin, Raise, and up to Protect IV, Shell IV, and Cure V on Campaign NPCs, anyone with Allied Tags on, and Beastmaster pets. Their spells seem to be on a timer, similar to Pixies. **The selection of spells they'll cast is dependent on conditions of the Royal Army of San d'Oria. Their capabilities can be augmented by doing the Cut and Cauterize (S) campaign ops. *They will not attack unless attacked. When attacked, he'll draw his hammer and start attacking the aggressor. This will often happen in battles with monsters that use AoE attacks (such as Battle Dance). *Has a finite MP pool, as of such will actually be seen in the Command/heal stance to recover MP and HP. You will often see them /heal after all Campaign mobs nearby are defeated and Campaign still continues because another wave is on the way. Because they are San d'Oria, their MP pool is smaller than those of the physicians of Windurst and Bastok (but have higher HP as a result). *In the event that the unit they arrived with retreats, they will remain on the battlefield and not retreat, remaining to assist anyone nearby and to fight if attacked. *Low defense and HP compared to other Royal Army units, as of such they wont last long when attacked. *Uses an ability called Goddess's Shield; this enables them to cast self-targeting spells like Blink and Phalanx on allied targets." },
    ['Royal Provisioner']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "San d'Oria (S)", "Varies" }, note = "Notes:\n* Appears during offensive campaigns against Beastman territories. Up to 3 provisioners may be present at one time. *Distributes temporary items to players allied with San d'Oria in the battle. *Upon the depletion of their stock, they temporarily return to headquarters to replenish their stores. *They take defensive action against aggressors, but during that time they cannot dispense items. If incapacitated, a replacement is dispatched after some time has passed. *Item availability and quantity is directly influenced by each nation's skill and production levels." },
    ['Scarlet Boar Esquire']             = { type = "Campaign Warrior", icon = "CampaignArbiter.png", zones = { "Battle", "East Ronfaure (S), Jugner Forest (S), Vunkerl Inlet (S), Batallia Downs (S), The Eldieme Necropolis (S).", "San d'Oria (S)" }, note = "Notes:\n* Appears during Campaign Battles , following Ashmea B Greinner. *Appear to be Warriors though wielding Polearms, similar to the Crimson Wolf Esquires." },
    ['Scorpion Caster']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Various Campaign Fortifications", "Windurst (S)" }, note = "Notes:\n* Leader of the Scorpion Casters is Gariri. *Squadron appears in various locations either fortifying or in Campaign Battles. *They are among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Windurst regains most territory in their cordon. *Cast high-tier area spells, such as Thundaga III." },
    ['Scylla Brigade Elite']             = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Belfry", "Jeuno (S)" }, note = "Notes:\n* Spawned by an Allied Armored Belfry erected by the any of the Allied Forces of Altana during an assault of Beaucedine Glacier (S) or Xarcabard (S). *Participates in offensive Campaign Battles. A maximum of 5 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter." },
    ['Scylla Brigade Healer']            = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Beaucedine Glacier (S), Xarcabard (S)", "Jeuno (S)" }, note = "Notes:\n:*Appears in Campaign battles along with another dispatched unit in Northland areas under Allied control; they never appear as a standalone unit. :*They will cast Blink, Phalanx, Stoneskin, Raise, and up to Protect IV, Shell IV, and Cure V on Campaign NPCs, anyone with Allied Tags on, and Beastmaster pets. Their spells seem to be on a timer, similar to Pixies. ::*Unknown how the selection of spells they'll cast is determined. :*They will not attack unless attacked. When attacked, he'll draw his hammer and start attacking the aggressor. This will often happen in battles with monsters that use AoE attacks (such as Battle Dance). :*Has a finite MP pool, as of such will actually be seen in the Command/heal stance to recover MP and HP. You will often see them /heal after all Campaign mobs nearby are defeated and Campaign still continues because another wave is on the way. :*In the event that the unit they arrived with retreats, they will remain on the battlefield and not retreat, remaining to assist anyone nearby and to fight if attacked. :*Have low defence and HP compared to other units, as of such they wont last long when attacked. :*Uses an ability called Goddess's Shield; this enables them to cast self-targeting spells like Blink and Phalanx on allied targets." },
    ['Scylla Brigade Officer']           = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Belfry", "Jeuno (S)" }, note = "Notes:\n* Spawned by an Allied Belfry erected by the any of the Allied Forces of Altana during an assault of Beaucedine Glacier (S) or Xarcabard (S). *Participates in offensive Campaign Battles. A maximum of 5 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter. *Casts Cure IV, Protect IV, and Shell III on themselves." },
    ['Selh\'teus']                      = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Battle", "Cutscene", "Lumoria" }, note = "Involved in Missions:\n* Promathia Mission 1-1: The Rites of Life\n* Promathia Mission 1-2: Below the Arks\n* Promathia Mission 1-3: The Mothercrystals\n* Promathia Mission 2-5: Ancient Vows\n* Promathia Mission 3-5: Darkness Named\n* Promathia Mission 4-3: The Secrets of Worship\n* Promathia Mission 5-1: The Enduring Tumult of War\n* Promathia Mission 5-2: Desires of Emptiness\n* Promathia Mission 5-3: Three Paths\n* Past Sins (Louverance Path)\n* Promathia Mission 6-2: A Place to Return\n* Promathia Mission 6-4: One to be Feared\n* Promathia Mission 7-5: The Warrior's Path\n* Promathia Mission 8-2: A Fate Decided\n* Promathia Mission 8-3: When Angels Fall\n* Promathia Mission 8-4: Dawn\n\nNotes:\n* A mysterious boy found in Delkfutt's Tower, seemingly at the center of the spreading Emptiness phenomenon." },
    ['Silver Fox Archer']                = { type = "Campaign Warrior", icon = "CampaignArbiter.png", zones = { "Battle", "Jugner Forest (S)", "San d'Oria (S)" }, note = "Notes:\n* Appears during Campaign Battles, following Laisavie X Berlends. *Uses the Weapon Skill \"Arching Arrow\"." },
    ['Stockade']                         = { type = "Bastion Structure", icon = "Dialogue.png", zones = { "Battle", "Yorcia Weald (U)" }, note = "Notes:\n* Spawns to protect the Cantonment in Yorcia Weald (U) Skirmishes. *Enemies attack the stockade before moving on to the Cantonment. *To spawn a stockade, players must select Defensive Measures from the Noetic Acension. (if you get 2 options in japanese, pick the top one. This probably just confirms your decision.)" },
    ['Temple Knight']                    = { type = "Campaign Knight", icon = "CampaignArbiter.png", zones = { "Battle", "San d'Oria (S)", "The Eldieme Necropolis (S)" }, note = "Notes:\n* See also The Temple Knights * Appear in campaign battles under the command of Febrenard C Brunnaut." },
    ['Tiyaash']                          = { type = "Quest Associate", zones = { type = "Quest Associate", "Battle", "Jade Sepulcher", "Outland" }, note = "Involved in Quests:\n* Moment of Truth" },
    ['Trion']                            = { type = "Prince", icon = "Dialogue.png", zones = { "Battle", "Cutscene", "Cutscenes, Chateau d'Oraguille", "San d'Oria" }, note = "Involved in Quests:\n* Under Oath\n* Lure of the Wildcat (San d'Oria)\n* Trust: Trion\n\nInvolved in Missions:\n* San d'Oria Mission 3-1: Infiltrate Davoi\n* San d'Oria Mission 5-2: The Shadow Lord\n* San d'Oria Mission 6-2: Ranperre's Final Rest\n* San d'Oria Mission 9-2: The Heir to the Light\n* Aht Urhgan Mission 4: Knight of Gold\n* Aht Urhgan Mission 7: Westerly Winds\n* Aht Urhgan Mission 39: Allied Rumblings\n* Aht Urhgan Mission 40: Unraveling Reason\n* A Crystalline Prophecy (Mission)\n* The Voracious Resurgence: Dancing Prince\n* The Voracious Resurgence: Altennia Burns Bright\n\nNotes:\nTrion is the eldest son of King Destin. He and his brother Pieuje are fierce rivals, and will disagree on almost anything. His sister is Claidie. Battle NPC: Trion fights alongside the party in the battle for San d'Oria Mission 9-2. He fights in the second half of the battle, against Warlord Rojgnoj, Rojgnoj's Left Hand, and Rojgnoj's Right Hand. Trion must be kept alive for this battle. If he dies, the battle is considered lost. Trion is a Paladin in all aspects of his fighting style. He casts White Magic, fights with a sword and shield but has amazingly low defense with a gigantic HP supply, something that resembles more of a Monk. Weaponskills: * Red Lotus Blade * Savage Blade" },
