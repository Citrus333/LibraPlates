    ['Daswil']                           = { type = "Mamool Assault", icon = "AssaultMissionGiver.png", zones = { "Al Zahbi", "Mamool Ja Staging Point (Bhaflau Thickets" }, note = "Starts Quests:\n* Beginnings\n\nInvolved in Missions:\n* Immortal Sentries\n\nNotes:\n* Speak with him to receive an Assault Armband for assault missions in Mamool Ja Training Grounds. Quote: \"It's as I told you--mortals were meant to seek power.\" \"But do not drown in its embrace\" \"Blue magic is the power of the beast within.\" \"As mortals, we can only control a small portion of this strength.\" \"If you forget this fact, and open the floodgates...\" \"Your very self will be washed away...\" \"Remember these words as the beast gnaws at your heart.\"" },
