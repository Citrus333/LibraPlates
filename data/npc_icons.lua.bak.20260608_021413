    ['Acacia']                           = { type = "Starlight Event", icon = "Event.png", zones = { "Batallia Downs" }, note = "Notes:\nThe Smilebringer Boot Camp will continue even after the conclusion of the Starlight Celebration, albeit with some changes in appearance and content. Smile sergeants will sport new attire, collect a participation fee in gil, and offer a different set of rewards for successful completion of the training." },
    ['Macro Test']                       = { type = "Test Target", icon = "Dialogue.png", zones = { "Batallia Downs" }, note = "Notes:\n* Batallia Downs: 2 Cardians *Rolanberry Fields: 3 Cardians *Sauromugue Champaign: 3 Cardians The Cardians live just outside the exits from Jeuno. As the name implies, their intended purpose is to allow players to test combat macros that are only usable during combat. * Check as \"Impossible to Gauge\". * Do not move or fight back. * Damage from all attacks (both physical and magical) is reduced to zero. * Completely immune to all enfeebles except Dia and Bio (damage over time from those two spells is also reduced to zero). * You cannot gain TP and you cannot gain combat or magic skillups from attacking them. * Their HP is shrouded at all times. Like Domain Invasion, Macro Test cardians can be attacked by any player regardless of party or alliance formation. Unlike Domain Invasion, Trusts can not be called out while engaged with a Macro Test cardian. You can disengage and immediately begin calling trusts." },
