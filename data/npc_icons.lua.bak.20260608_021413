    ['Albrecht']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Jeuno", "None" }, note = "Involved in Quests:\n* Save My Sister" },
    ['Alexander (NM)']                   = { type = "Citizen", zones = { "Cutscene" } },
    ['Alista']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Jeuno", "None" }, note = "Involved in Quests:\n* Save My Sister\n\nNotes:\nShe is Albrecht's sister." },
    ['Allaipre']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Involved in Missions:\n* The Queen of the Dance" },
    ['Alphonimile']                      = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Involved in Quests:\n* Gifts of the Griffon\n* Perils of the Griffon\n* In a Haze of Glory\n* The Price of Valor\n* Blood of Heroes\n\nNotes:\nThe father of Excenmille." },
    ['Altana']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene" }, note = "Involved in Missions:\n* *{{Information Needed\n\nNotes:\nAltana is the Dawn Goddess and creator of Vana'diel. It is said that she created the Zilart, but once they were destroyed, she cried five tears down on the world that resulted in the creation of the five races: Hume, Elvaan, Mithra, Tarutaru and Galka. The Twilight god Promathia resented this, and created evil monsters that would seek to destroy Altana's creations. Promathia also cursed each of the five races with one negative trait each, for example, the Elvaan became arrogant. Altana is often mentioned and is the central character for the religion in Vana'diel, represented by the San d'Orian Cathedral. During the Crystal War, all four nations joined forces under the name of The Allied Forces of Altana." },
    ['Altennia']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "San d'Oria (S)", "Southern San d'Oria (S) cutscenes" }, note = "Involved in Quests:\n* Gifts of the Griffon\n* Claws of the Griffon\n* Wrath of the Griffon\n* Perils of the Griffon\n\nNotes:\nAltennia is a young squire who looks after the Young Griffons, and is normally the only adult they allow in on their meetings. She is the sister of Halver." },
    ['Alystair']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Jeuno (S)" }, note = "Involved in Missions:\n* Cavernous Maws (WOTG01)\n* A Nation on the Brink (WOTG14)\n\nNotes:\n* He is a Corporal of the Ducal Knights of the Grand Duchy of Jeuno during the Crystal War. *His supervisor is Sergeant Barnabas under the leadership of Captain Lysander." },
    ['Annika']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene" }, note = "Involved in Quests:\n* The Unfinished Waltz (DNC AF1)\n\nNotes:\nLaila's mother." },
    ['Aquila']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene" }, note = "Involved in Missions:\n* WOTG07: Purple, The New Black\n* WOTG08: In the Name of the Father\n* WOTG09: Dancers in Distress\n* WOTG15: Crossroads of Time\n* WOTG19: Betrayal at Beaucedine\n* WOTG25: The Will of the World\n* WOTG26: Fate in Haze\n* WOTG37: Darkness Descends\n\nNotes:\nOne of the Spitewardens of Lady Lilith, the leader of the \"Cryptscale Protectorate\" appears to be a human fomor. He acts very childish and frequently rubs Haudrale the wrong way...." },
    ['Ark Angel EV']                     = { type = "Ark Angel", icon = "MissionNPC.png", zones = { "Cutscene", "Lumoria" }, note = "Involved in Quests:\n* Divine Might\n* Temper Your Arrogance\n\nInvolved in Missions:\n* Zilart Mission 1: The New Frontier\n* Zilart Mission 8: Return to Delkfutt's Tower\n* Zilart Mission 14: Ark Angels\n* Promathia Mission 7-5: The Warrior's Path\n\nNotes:\n* One of the five Ark Angels that protect the crystal." },
    ['Ark Angel GK']                     = { type = "Ark Angel", icon = "MissionNPC.png", zones = { "Cutscene", "Lumoria" }, note = "Involved in Quests:\n* Divine Might\n* Quell Your Rage\n\nInvolved in Missions:\n* Zilart Mission 1: The New Frontier\n* Zilart Mission 8: Return to Delkfutt's Tower\n* Zilart Mission 14: Ark Angels\n* Promathia Mission 7-5: The Warrior's Path\n\nNotes:\n* One of the five Ark Angels that protect the crystal." },
    ['Ark Angel HM']                     = { type = "Ark Angel", icon = "MissionNPC.png", zones = { "Cutscene", "Lumoria" }, note = "Involved in Quests:\n* Divine Might\n* Eliminate Your Apathy\n\nInvolved in Missions:\n* Zilart Mission 1: The New Frontier\n* Zilart Mission 8: Return to Delkfutt's Tower\n* Zilart Mission 14: Ark Angels\n* Promathia Mission 7-5: The Warrior's Path\n\nNotes:\n* One of the five Ark Angels that protect the crystal." },
