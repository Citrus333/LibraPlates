    ['Cornelia']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok", "Cutscene", "Various cutscenes Her room is behind the President ( Bastok Metalworks:" }, note = "Involved in Quests:\n* Beauty and the Galka\n* Fallen Comrades\n* Rivals\n\nInvolved in Missions:\n* Bastok Mission 3-1: The Four Musketeers\n* Bastok Mission 5-1: Darkness Rising\n* Bastok Mission 7-1: The Final Image\n* Bastok Mission 7-2: On My Way\n* Bastok Mission 9-2: Where Two Paths Converge\n* Promathia Mission 3-1: Call of the Wyrmking\n* Promathia Mission 5-3: Three Paths\n* Past Sins (Louverance Path)\n* The Voracious Resurgence #1: The Gloom Phantom's Approach\n* The Voracious Resurgence #2: The Brygid Cup\n\nNotes:\nThe 20-year-old daughter of the current President Karst of Bastok, and granddaughter of Senator Derek Karst. Her late mother named her after the Mythril Musketeer Cornelia in the hopes that she would treat everyone equally and be loved by all. *Side note: Her favorite sandwich is the Omelette Sandwich." },
