    ['Valaineral R Davilles']            = { type = "Battle", icon = "Dialogue.png", zones = { "Battle", "East Ronfaure (S), Southern San d'Oria (S)", "San d'Oria (S)" }, note = "Involved in Quests:\n* The Long March North\n\nInvolved in Missions:\n* Delkfutt the Great\n\nNotes:\n* Appears in campaign battles as the leader of the Royal Guard. *Valaineral is among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once San d'Oria regains most territory in their cordon. *Wields a Hauteclaire with a 100% proc rate additional effect: Light Damage. The additional light damage often deals a great amount of damage to enemies. *Periodically uses Shield Bash. *Casts Protect IV, Shell IV, Cure IV, Flash, Holy and Banish III. *Uses Invincible. *Has a moderate Auto Regen effect. *Davilles favours using an AoE Light-based weapon skill, Uriel Blade. *Has access to all Sword Weapon Skills." },
    ['Vhino Delkahngo']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* When One Man Is Not Enough\n\nNotes:\n:*Appears during Campaign Battles as the leader of the Crocodile Mercenaries. :*Vhino's mercenaries are only deployed to Sauromugue Champaign (S). :*Vhino uses her own special ranged weaponskill called Soulfetter Arrow. :*Vhino has relatively high evasion and uses Triple Attack, suggesting that she may also be a Thief. :*Talk: Back in my home, Ulbuka, I hear rumors of great riches in eastern lands. But now I am here, and where are riches? I see nothing but Tarus! Ahahahaha! :*Battle cry: Petty beastmen hordes are nothing compared to giant wildebeests of homeland! I swat you all down like fruit flies!" },
    ['Wildcat Vanguard']                 = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Belfry", "Windurst (S)" }, note = "Notes:\n* Spawned by an Allied Belfry erected by the Federal Forces of Windurst. Participates in offensive Campaign Battles. A maximum of 6 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter. *The Wildcat Vanguards dual-wield daggers in battle, and will use various Dagger weaponskills up to Energy Drain, as well as Ninjutsu magic." },
    ['Wildcat Volunteer']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Varies", "Windurst (S)" }, note = "Notes:\n* Appears during Campaign Battles as part of the Wildcat Volunteer squadron led by Haja Zhwan." },
    ['Yrvaulair S Cousseraux']           = { type = "Campaign Hero", icon = "TacticalAssessment.png", zones = { "Battle", "San d'Oria (S)", "Spotted at: East Ronfaure (S), Jugner Forest (S), The Eldieme Necropolis (S), Batallia Downs (S), and Vunkerl Inlet (S)." }, note = "Involved in Quests:\n* Knot Quite There\n* A Manifest Problem\n\nNotes:\n*  Appears to be DRG/PLD. * Casts Protect IV, Shell IV and Cure IV on himself when needed. * Uses Invincible. * Has access to all Polearm WS's including Impulse Drive. * Yrvaulair throws special \"Volant Angon\" that inflict direct damage. * Will not engage an enemy with his weapon unless they come within melee range, will stand back and throw his Angons. * Talk: Not once in the four hundred years since the dawn of the Royal Knights has the kingdom found itself in such peril. Let us take up our pikes and stand our ground to ensure another four centuries of prosperity! * Battle cry: My spear is lightning...and your scream shall be the thunder which follows my mighty strike!" },
    ['Zolku-Azolku']                     = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* A Manifest Problem\n* Howl from the Heavens\n\nNotes:\n:*Can use Tabula Rasa. :*Appears during Campaign Battles as the leader of the Libran Casters. :*Zolku-Azolku is a SCH, and will often be seen casting a weather spell on himself, followed immediately by a helix spell of the same element on an enemy. He also has access to tier IV elemental nukes as well as Ancient Magic II and other enfeebling black magic. :*Zolku-Azolku will normally use the weaponskill Retribution. However, when his health is critically low, he'll start using his unique and powerful weaponskill Death Knell, which attempts to doom all enemies in range. It's not uncommon for him to take out a large amount of beastmen with him whenever he gets swarmed. :*Talk: We all wear masks because deep down inside we are nothing but beasts. The question I ask you is, to which do you submit--the mask, or the beast? :*Battle Cry: I think I've had enough of this volume!" },
    ['Zonpa-Zippa (S)']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Battle", "Windurst (S)", "Windurst Waters (S)" }, note = "Involved in Quests:\n* Knot Quite There\n* A Manifest Problem\n* Howl from the Heavens\n\nNotes:\n:*Appears during Campaign Battles as the leader of the Capricornian Casters. :*His squadron is only deployed to West Sarutabaruta (S) and Windurst Waters (S), as he is also in command of the city defenses. :*In battle, he calls upon his strongest creations, the Ace Cardians to fight along side him. Uses Overdrive with Ace Cardians. :*Casts Banishga II, Protect IV, Curaga IV and Holy. Uses the weaponskill Black Halo. :*Talk: Have fun while you can, filthy mercenary, because before long you'll be back on the streets where you belong--replaced by a quiet, obedient army of Cardians! :*Battle cry: Invincible! Indestructible! Indubitable! The age of Cardians is upon us!" },

