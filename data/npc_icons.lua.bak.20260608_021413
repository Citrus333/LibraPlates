    ['Amutiyaal']                        = { type = "Teleport Service", icon = "WarpNPC.png", zones = { "San d'Oria", "Southern San d'Oria" }, note = "Starts Quests:\n* Lure of the Wildcat (San d'Oria)\n\nNotes:\nTeleportation Service: :Available to registered mercenaries upon completion of Lure of the Wildcat (San d'Oria). :Teleports you to Aht Urhgan Whitegate (I-12) if you trade him 300g." },
