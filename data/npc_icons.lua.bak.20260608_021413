    ['Amar']                             = { type = "Mission Associate", zones = { "Bastok", "Bastok Mines" }, note = "Involved in Missions:\n* Bastok Mission 8-2: Enter the Talekeeper" },
    ['Angry Bull']                       = { type = "Great War Recaller", icon = "Dialogue.png", zones = { "Bastok", "Bastok Markets" }, note = "Notes:\nDialogue: I remember 20 years ago when I was in charge of protecting Galkan Bridge from the beastmen. For a large part of the Crystal War, we had her blocked off on both sides. The government said it was to keep enemy spies from infiltrating Bastok's central areas. However, there was rumor that it was to prevent Galka from coming over on this side of the river and rioting. It would be a lie if I told you it wasn't hard for me, a Galka, to work against my brothers like that. I still have nightmares about the time I had to force back groups of refugees trying to escape the flames that engulfed their homes in the mines district. And now I'm back here patrolling the bridge as I did long ago. Perhaps destiny has a tighter grip on us than I thought..." },
