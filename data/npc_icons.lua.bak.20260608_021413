    ['Wahid']                            = { type = "Quest Giver", icon = "QuestGiver.png", zones = { "Bastok", "Bastok Mines" }, note = "Involved in Quests:\n* The Siren's Tear" },
    ['Werei']                            = { type = "Mission", icon = "MissionNPC.png", zones = { "Bastok" }, note = "Involved in Missions:\n* Enter the Talekeeper\n\nNotes:\nWerei is the oldest Galka living in Bastok, and has been a major leader within the Galka community and Bastok as a whole for several decades. His sudden disappearance has become a major crisis point for the nation. In one of the few cut scenes where he is physically witnessed, he tells a story about how the Galkas died while being attacked by the Antica." },
