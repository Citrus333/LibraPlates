    ['Bonmaurieut']                      = { type = "Regional Vendor", icon = "RegionalVendor.png", zones = { "Port San d'Oria", "San d'Oria" } },
    ['Bricorsant']                       = { type = "Adventurer's Assistant", icon = "AdventurersAssistant.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Notes:\n* This NPC will display a map of San d'Oria." },
    ['Brifalien']                        = { type = "Riding the Clouds", icon = "QuestNPC.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Riding on the Clouds\n\nNotes:\n*  Dialogue: Hey! Salute when you speak to me! I am second captain of the Royal Knights Youth Division! Don't make me use my nirvana slash on you! Maybe we could use you. You'd be just a private...but there is plenty of opportunity for advancement. * Described in Riding on the Clouds as, \"A second knight who specializes in the nirvana slash.\"" },
    ['Callort']                          = { type = "Airship Travel", icon = "AirshipTravelAgent.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Notes:\nDialogue: Airships fly between our kingdom and the Grand Duchy of Jeuno to the east. I'll never forget the first day I saw one of those ships fly... Jeuno's history is short, but quickly did that village of Hume fishermen grow into what it is today. When their archduke came to power, he excavated the ruins nearby. The knowledge they found there made them as mighty as San d'Oria, by any reckoning. But once a fisherman, always a fisherman, I say. 'Tis the Elvaan of San d'Oria that will rule Vana'diel, mark my words!" },
    ['Ceraulian']                        = { type = "Dragoon AF Quest", icon = "afstorage.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Starts Quests:\n* Chasing Quotas\n\nInvolved in Quests:\n* The Holy Crest\n* Knight Stalker" },
    ['Cherlodeau']                       = { type = "Wildcat Recruiter", icon = "QuestGiver.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Lure of the Wildcat (San d'Oria)\n\nNotes:\nDialogue: If quest \"Lure of the Wildcat (San d'Oria)\" is active: Hmph, thinking of becoming a mercenary, are you? Let me give you some advice: The beastmen of the Near East are far more savage than the fiends of Ronfaure. I would avoid those lands until I was sure of my strength. They care not who they kill--in that respect, they are much like the Orcs. In war, survival is key. Picking your battles in also a valid strategy. Artinien: That's called \"Knowing your enemy,\" that is! Brifalien: Yeah! \"Knowing your anemone!\"" },
