    ['Sunny-Pabonny']                    = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Windurst" }, note = "Involved in Quests:\n* SMN AF2: Class Reunion\n\nNotes:\n* Sunny-Pabonny is a former student of the Windurstian ex-Minister Shantotto. He has a pet sapling named Sunny Junior that follows him. When Sunny-Pabonny attempts to enter the Ice Protocrystal in the Cloister of Frost, the sapling transforms into 6 Dryads which must be defeated." },
