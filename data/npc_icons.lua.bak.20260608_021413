    ['Bonchacha']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Windurst", "Windurst Walls" }, note = "Notes:\nDialog: Professor Koru-Moru, the old minister who lives in that manor there, is more famous for being the local ding-a-ling than for serving as the School of Magic's principal! I just know he's up to something in there! I came over to call in and have a little chitchat, but it seems as if he is, how shall we say...otherwise occupied...?" },
