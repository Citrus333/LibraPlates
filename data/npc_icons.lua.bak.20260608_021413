    ['Francmage']                        = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "San d'Oria", "Various cutscenes" }, note = "Involved in Quests:\n* Signed in Blood\n* Tea with a Tonberry?\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n\nNotes:\nBefore the outbreak of the Crystal War, Francmage was the head of the Knights Mistalle, a noble San d'Orian family who owned the territory within Carpenters' Landing. He was sent along with Mythril Musketeers Ulrich, Raogrimm and Cornelia to investigate the northlands in cooperation with Yow Rabntah and Iru-Kuiru of Windurst." },
