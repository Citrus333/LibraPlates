    ['Fantarviont']                      = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\n\"In the war twenty years ago, San d'Orian knights crushed the Shadow Lord and his hordes. We sealed off the Northlands from whence he came. \"Eh? Windurst and Bastok? They could barely protect their gates! If it weren't for the valor of our knights, all would have fallen into shadow!\"" },
