    ['Foudeel']                          = { type = "Chocobo Guide", icon = "ChocoboRenter.png", zones = { "Al Zahbi", "Cutscene" }, note = "Involved in Quests:\n* Give Peace a Chance\n* Three Men and a Closet\n\nNotes:\n* Friends with Bashraf and Wahboud; the three are seen during the Three Men and a Closet quest cutscenes. *Appears during the Sunbreeze Festival event Fantastic Fraulein Mumor 2010 to heckle Mumor and Uka. *If you are raising a chocobo, starting at the adolescent stage you will meet them on a walk in Tahrongi Canyon, La Theine Plateau, or Konschtat Highlands where they are raising a chocobo together. They will challenge you to a friendly competition. *There is a chance he will jockey for their chocobo during official races. If he does, Sakura, translated through Markovich, comments, \"It's rumored that Foudeel often spends weeks planning out strategies for each of his two-minute races.\"" },
