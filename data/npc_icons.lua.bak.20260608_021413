    ['Rongelouts']                       = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Al Zahbi", "Cutscene" }, note = "Involved in Quests:\n* Promotion: Second Lieutenant\n* Promotion: First Lieutenant\n\nNotes:\nA veteran knight captain of the Crystal War, Rongelouts is employed as a drill sergeant for Salaheem's Sentinels." },
