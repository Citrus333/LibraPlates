    ['Maloquedil']                       = { type = "Quest Giver", icon = "QuestGiver.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Starts Quests:\n* Warding Vampires\n\nInvolved in Quests:\n* Riding on the Clouds\n* Lure of the Wildcat (San d'Oria)\n\nNotes:\n* Dialogue: Once quest \"Warding Vampires\" has been completed: I still seek 2 bulbs of shaman garlic! I cannot seem to get enough! If quest \"Lure of the Wildcat (San d'Oria)\" is active: Have you heard much about the company distributing those badges? Their headquarters are in a Near Eastern town clled \"Al Zahbi.\" Rumor has it that the company president is something of a miser. What could they possibly want with San d'Oria? You may want to think twice before clipping on one of those things. * Described in Riding on the Clouds as, \"A young elvaan whose breath stinks.\"" },
    ['Matildie']                         = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Notes:\nDialogue: Anilla: Is it just me, or are there more strangers in town these days? Whatever could it mean? Matildie: What, have you not heard? They are recruiting adventurers in droves! I hear they're taking any who will come-- foreigners, even! Anilla: Well, guess what happened to me. I was tidying the house yesterday, when a strange man walked in. He then ran out the veranda without even saying hello! Matildie: Shame on those adventurers! At least they could knock before barging into our homes. |" },
