    ['Semih Lafihna']                    = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Cutscenes Only", "Windurst" }, note = "Involved in Quests:\n* Sin Hunting\n* Fire and Brimstone\n* Unbridled Passion\n\nInvolved in Missions:\n* Bastok Mission 2-3: The Emissary\n* Windurst Mission 2-3: The Three Kingdoms\n* Windurst Mission 3-1: To Each His Own Right\n* Windurst Mission 5-1: The Final Seal\n* Windurst Mission 6-1: Full Moon Fountain\n* Windurst Mission 8-2: The Jester Who'd Be King\n* Windurst Mission 9-1: Doll of the Dead\n* Windurst Mission 9-2: Moon Reading\n* A Crystalline Prophecy (Mission)\n\nNotes:\nSemih Lafihna is leader of the Sibyl Guards and the Star Sibyl's personal Patriarch Protector. There are rumors that Semih will become the next Tribal Chieftainess of the Windurst Mithra tribes." },
    ['Shantotto (S)']                    = { type = "Quest Giver", icon = "QuestGiver.png", zones = { "Cutscene", "Windurst (S)" }, note = "Involved in Quests:\n* A Feast for Gnats\n* The Long March North\n\nNotes:\n* Currently is considered the \"former\" Minister of the Orastery. She's been sentenced to exile and stripped of all military authority. *She is currently traveling with the Leonian War Warlocks \"forced\" by Doron-Fulan to do his bidding. See also: Lady Shantotto Exposed!" },
    ['Shayeeha']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene" }, note = "Involved in Quests:\n* Embers of His Past\n\nNotes:\n* Shayeeha was once a commander of a squadron in the Inexorables of Aht Urhgan. Later she advanced to hold a seat on the war council of the Far East." },
    ['Shikaree G']                       = { type = "Shikaree", icon = "Dialogue.png", zones = { "Cutscene", "Outland" }, note = "Involved in Quests:\n* When One Man Is Not Enough\n* A Feast for Gnats\n* Sins of the Mothers\n* Howl from the Heavens\n* Manifest Destiny\n* At Journey's End\n\nNotes:\n* One of the Mithran Trackers from Olzhirya, who is pursuing Lehko Habhoka for unknown reasons. *She is the mother of Shikaree X Shikaree Y and Shikaree Z according to Koh Lenbalalako" },
    ['Shikaree X']                       = { type = "Cutscene, Mission Boss", icon = "MissionNPC.png", zones = { "Cutscene", "Outland", "Various Cutscenes, Boneyard Gully" }, note = "Involved in Quests:\n* Tango with a Tracker\n* Requiem of Sin\n* X Marks the Spot\n\nInvolved in Missions:\n* Promathia Mission 5-3: Three Paths\n* Where Messengers Gather (Ulmia's Path)\n* Promathia Mission 7-4: Calm Before the Storm\n* Promathia Mission 8-4: Dawn\n\nNotes:\n* One of the three Mithran Tracker sisters (a.k.a. \"The Sin Hunters\") from Olzhirya. *She and her sisters are the daughters of Shikaree G according to Koh Lenbalalako" },
