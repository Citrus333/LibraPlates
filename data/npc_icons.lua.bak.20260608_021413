    ['Pomilla']                          = { type = "Wildcat Recruiter", icon = "QuestGiver.png", zones = { "Port San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Lure of the Wildcat (San d'Oria)\n\nNotes:\nDialogue: If quest \"Lure of the Wildcat (San d'Oria)\" is active: I hear frightful tales from the Near East. They say that the beastmen are leading armies into the lands of people. That badge... It is as if the terrible events of twenty years past have returned to haunt us... Yes, the nation they speak of lies far away, yet I feel the seed of fear blossom in my heart. War is like a raging fire that leaps from country to country, consuming all in its path..." },
