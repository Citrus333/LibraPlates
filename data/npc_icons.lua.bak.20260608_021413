-------------------------------------------------------------------------------
    ['Bearer of Darkness']               = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cut Scenes Only", "Windurst" }, note = "Involved in Quests:\n* Sin Hunting\n* Wings of the Goddess Windurst Missionquest 9: The Forbidden Path\n\nInvolved in Missions:\n* Magicite (Bastok)\n* Magicite (San d'Oria)\n* Magicite (Windurst)\n* Windurst Mission 8-1 Vain\n* Windurst Mission 9-1 Doll of the Dead\n* Windurst Mission 9-2 Moon Reading\n\nNotes:\nAn enigmatic creature of powerful dark magic, but when attacked, its blood shines a pure white that turns to shimmering dust on the ground. It has a strange habit of appearing at bodies of water during the full moon and seems to have an obsession with the Star Sibyl." },
    ['Eald\'narche']                    = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cut Scenes Only", "Cutscene", "Jeuno" }, note = "Involved in Quests:\n* Apocalypse Nigh\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* Zilart Mission 1: The New Frontier\n* Zilart Mission 8: Return to Delkfutt's Tower\n* Zilart Mission 16: The Celestial Nexus\n* Promathia Mission 1-3: The Mothercrystals\n* Promathia Mission 7-5 :The Warrior's Path\n\nNotes:\n* Brother of Kam'lanaut, the Archduke of the Grand Duchy of Jeuno. It is said that he had lost his eye when he was younger. But like Kam'lanaut, there's more to him than meets the eye...." },
    ['Iru-Kuiru']                        = { type = "Rhinostery Minister", icon = "Dialogue.png", zones = { "Cut Scenes Only", "Cutscene", "Windurst" }, note = "Involved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n\nNotes:\nBefore the outbreak of the Crystal War, Iru-Kuiru was one of the ministers for the Rhinostery, along with Yow Rabntah. They were sent along with Mythril Musketeers Ulrich, Raogrimm, and Cornelia to investigate the northlands in cooperation with Francmage of San d'Oria. Some time after returning from the expedition he was mysteriously murdered." },
    ['Kam\'lanaut']                     = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cut Scenes Only", "Cutscene", "Jeuno" }, note = "Involved in Quests:\n* Apocalypse Nigh\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* Zilart Mission 1: The New Frontier\n* Zilart Mission 8: Return to Delkfutt's Tower\n* Promathia Mission 7-5 :The Warrior's Path {{verification\n\nNotes:\nKam'lanaut is the Archduke of the Grand Duchy of Jeuno, and the one who introduced the art of crystal synthesis to Vana'diel as well as the brother of Eald'narche. Kam'lanaut is one of very few characters that are left-handed." },
    ['Shikaree M']                       = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cut Scenes Only", "Cutscene", "Outland" }, note = "Involved in Quests:\n* Sin Hunting\n* Fire and Brimstone\n* Unbridled Passion\n\nNotes:\n* One of the Mithran Trackers from Olzhirya and is involved in the ranger af quests. *Is tracking down the daughter of Nhev Befrathi for her mother's sins." },
    ['Yow Rabntah']                      = { type = "Ranger", icon = "Dialogue.png", zones = { "Cut Scenes Only", "Cutscene", "Kazham" }, note = "Involved in Quests:\n* Sins of the Mothers\n\nInvolved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n\nNotes:\n* Yow Rabntah was a Ranger from Kazham. Before the outbreak of the Crystal War, Iru-Kuiru, the minister for the Rhinostery, hired her to assist on the Multi-National Expedition to the Northlands. She was sent along with three Mythril Musketeers -- Ulrich, Raogrimm, and Cornelia -- to investigate the northlands in cooperation with Francmage of San d'Oria." },

