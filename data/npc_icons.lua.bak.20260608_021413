    ['King Destin']                      = { type = "King", icon = "Dialogue.png", zones = { "Cutscene", "Cutscenes", "San d'Oria" }, note = "Involved in Missions:\n* San d'Oria Mission 4-1: Magicite\n* Bastok Mission 4-1: Magicite\n* Windurst Mission 4-1: Magicite\n* San d'Oria Mission 5-2: The Shadow Lord\n* San d'Oria Mission 9-2: The Heir to the Light\n\nNotes:\nKing Destin is the king of San d'Oria. His wife passed away long ago. He is the father of Prince Trion, Prince Pieuje and Princess Claidie. The King is also first cousin and good friend of Valaineral R Davilles, from whom he learned most of his diplomacy and public affair skills." },
