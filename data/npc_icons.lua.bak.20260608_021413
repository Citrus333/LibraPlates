    ['Phairupegiont']                    = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Northern San d'Oria", "San d'Oria" }, note = "Involved in Quests:\n* Lure of the Wildcat (San d'Oria)\n\nNotes:\nDialogue: Ever heard of the Brugaire Consortium? They're the largest trading company in San d'Oria, with merchants traveling as far as Jeuno. The vast cargo rooms down at the port belong to them, you know. If quest \"Lure of the Wildcat (San d'Oria)\" is active: Yes, I know of the badge you wear. I was in the port when the Brugaire Consortium was unloading a large shipment of the things. I wonder if even the Brugaire Consortium goes too far, sometimes. This strange foreign cargo will land them in deep water with the Temple Knights, you mark my words." },
