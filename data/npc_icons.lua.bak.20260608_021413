    ['Fardimant X Boncourge']            = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Phomiuna Aqueducts", "Tavnazian Safehold" }, note = "Involved in Quests:\n* Knocking on Forbidden Doors\n\nNotes:\nThere is some discrepancy in this NPC's biographical data between the Japanese version and all other versions. The Japanese dialogue for the quest \"Knocking on Forbidden Doors\" refers to him by first name only, and he is referred to by first name only in the zone object name files. Furthermore, the Japanese dialogue says that he has been in the aqueducts for twenty years, while the English dialogue says that it is over two hundred! The latter is probably a translation error, since Chemioue mentions Fardimant retired there after the Great War." },
    ['Fenrir (NPC)']                     = { type = "Cutscene NPC/Summoned Avatar", zones = { "Cutscene", "Full Moon Fountain", "Windurst" }, note = "Involved in Quests:\n* The Moonlit Path\n* Mama Mia\n* Howl from the Heavens\n\nInvolved in Missions:\n* Windurst Mission 9-1: Doll of the Dead\n* Windurst Mission 9-2: Moon Reading\n* Promathia Mission 5-3: Three Paths\n* The Pursuit of Paradise (Tenzen's Path)" },
    ['Flit']                             = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Various cutscenes, the Ashu Talif" }, note = "Involved in Missions:\n* Aht Urhgan Mission 15: The Black Coffin\n* Aht Urhgan Mission 22: Shield of Diplomacy\n* Aht Urhgan Mission 29: Puppet in Peril\n* Aht Urhgan Mission 30: Prevalence of Pirates\n* Aht Urhgan Mission 35: Legacy of the Lost\n* Aht Urhgan Mission 36: Gaze of the Saboteur\n* Aht Urhgan Mission 37: Path of Blood\n* The Battle of Xarcabard\n\nNotes:\n* A crafty imp in the employ of Prince Luzaf. *At the side of the Shadow Lord during the Crystal War." },
