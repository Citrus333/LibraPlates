    ['King of Wands']                    = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Inner Horutoto Ruins" }, note = "Involved in Missions:\n* Windurst Mission 3-2: Written in the Stars\n\nNotes:\nThe King of Wands appears along with the King of Batons during a cutscene for Windurst Mission 3-2 Written in the Stars. They are behind the Gate of Light where they can not be reached, however they are both visible on Wide Scan, along with an invisible NPC named \"gohu\" (probably a placeholder for the talisman), which is not visible on Wide Scan. More information can be found at [http://www.ffxionline.com/forums/general-ffxi-discussion/75301-king-batons-king-wands-gohu.html this link]." },
