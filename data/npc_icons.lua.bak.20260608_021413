-------------------------------------------------------------------------------
    ['1st Gold Musketeer']               = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Rolanberry Fields (S), Pashhow Marshlands (S), Grauberg (S) Bastok Markets (S)" }, note = "Notes:\nFollows Elivira. Uses Marksmanship weaponskills." },
    ['1st Iron Musketeer']               = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Rolanberry Fields (S), Pashhow Marshlands (S), North Gustaberg (S)" }, note = "Notes:\n*  Appears during Offensive Campaign Battles in Rolanberry and Pashhow, following Bartholomaus. They will cure themselves and Bartholomaus, as well as use tier III black magic on their targets. *They are among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Bastok regains most territory in their cordon." },
    ['1st Legion Aidman']                = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Belfry" }, note = "Notes:\n* Spawned by an Allied Belfry erected by the Republican Army of Bastok. Participates in offensive Campaign Battles. A maximum of 5 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter. *Capable of casting a few spells such as Diaga II, Dia II, Banish III, Banishga III, Poisona and Holy which they will use very often. *They fight with Hand-to-Hand damage and are capable of using the following weaponskills: Combo, Spinning Attack, One Inch Punch, Raging Fists and Backhand Blow. \"1st Legion\" probably indicates they are part of Legatus Berger's 1st Division/Legion." },
    ['1st Legion Mercenary']             = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Belfry" }, note = "Notes:\n* Spawned by an Allied Armored Belfry erected by the Republican Army of Bastok. Participates in offensive Campaign Battles. A maximum of 5 reinforcements will appear, and they will continually respawn unless the belfry is demolished. *They will immediately charge to the Fortifications and attack any defenders they encounter." },
    ['1st Legion Reiter']                = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)Crawlers' Nest (S)", "Battle" }, note = "Notes:\n* Appears in Campaign Battles in Bastok Markets (S) and Crawlers' Nest (S), following Else. They will cure themselves, as well as Else. *\"1st Legion\" probably indicates they are the cavalry of Legatus Berger's 1st Division/Legion." },
    ['1st Legionnaire']                  = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Grauberg (S)" }, note = "Notes:\n* Appears during Campaign Battles in North Gustaberg and Grauberg, following Maximilian. Uses Marksmanship weaponskills. *They are among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Bastok regains most territory in their cordon." },
    ['2nd Legion Grenadier']             = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Battle", "Rolanberry Fields (S)" }, note = "Notes:\n* Appears in Campaign Battles at Rolanberry Fields, following Striking Bull. *\"2nd Legion\" probably indicates they are the heavy infantry of Legatus Eichberg's 2nd Division/Legion." },
    ['2nd Legionnaire']                  = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "North Gustaberg (S)" }, note = "Notes:\nParticipates in offensive Campaign Battles in North Gustaberg (S). Casts Dark Knight spells (such as Absorb-TP), but uses polearm weaponskills at least up to Skewer." },
    ['3rd Legionnaire']                  = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "North Gustaberg (S) during Campaign" } },
    ['4th Legionnaire']                  = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Varies" }, note = "Notes:\n* Appears during Campaign Battles as part of the Fourth Division Centurion unit. *In areas under allied control, they will deliver supplies to the fortifications and warp out. *In areas under beastman control, they will attempt to bomb the fortifications. *They will attempt to construct an Allied Belfry in offensive Campaign battles when Bastok's technological level allows." },
    ['7th Cohor Legionnaire']            = { type = "Campaign Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Everbloom Hollow" }, note = "Involved in Missions:\n* A Nation on the Brink (WOTG14)\n\nNotes:\n* Fights alongside Zazarg during the mission A Nation on the Brink." },
    ['8th Iron Musketeer']               = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Crawlers' Nest (S), North Gustaberg (S), Bastok Markets (S), Grauberg (S)" }, note = "Notes:\nParticipates in offensive Campaign Battles in Crawlers' Nest, following Kurt. Uses Ranged Attacks and Ninjutsu." },
    ['Adelbrecht']                       = { type = "Centurion", icon = "Guard.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Starts Quests:\n* The Fighting Fourth\n\nInvolved in Missions:\n* Back to the Beginning\n\nNotes:\n* Adelbrecht is a Centurion of the Republican Legion." },
    ['Adelheid']                         = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:* Appears during Campaign Battles in Grauberg (S) and Bastok Markets (S) as the leader of the 2nd Legion Scouts. Also appears in Ruhotz Silvermines during the quest Fire in the Hole. :* Summons various status ailment \"tubes\" (e.g. Silence Tube, Stun Tube, etc.) into the battle. These Tubes inflict a status ailment on opposing forces in an area of effect. :* Casts all Tier IV spells and all spells available to a Red Mage (Dia III, Gravity, Bind, Silence, etc.) Also uses Stun and Sleepga II. :* Like most unique generals she has a distinct weapon, in her case she wields Seveneyes. :* Uses Seraph Strike for ~200 damage, and Judgment for 500+ damage, but won't naturally walk within melee range. Also uses Moonlight and Starlight. :* Uses Tabula Rasa. :* Talk: ...Heavy infantry, five columns of 200... Two 100-knight regiments... Enemy force casualties estimated at 5,000... Oh, I apologize, soldier. I've spent the past few nights preparing for a joint operation with San d'Oria's Royal Knights. :* Battle Cry: A good soldier always comes prepared. Hehehehe!" },
    ['Adelheid Sturm']                   = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* Burden of Suspicion\n* Fire in the Hole\n\nNotes:\n* Seen eavesdropping in several Bastok Crystal War quests. \"...Heavy infantry, five columns of 200... Two 100-knight regiments... Enemy force casualties estimated at 5,000... Oh, I apologize, soldier. I've spent the past few nights preparing for a joint operation with San d'Oria's Royal Knights.\" Background: The name \"Adelheid Sturm\" can actually be seen as a clever pun. Adelheid is a proper name, but \"Adel\" is phonetically identical to the English word \"addle\", meaning to confuse, and \"heid\" is very similar to the German ending \"-heit\", which is an ending expressing state of being. \"-heit\" does not have a direct English translation but is roughly equivalent to the English ending \"-ness\", although in practice it is not always translated. (E.g. with the word \"Krankenheit\", meaning \"sickness\", the -heit is carried over to English, but for \"Sicherheit\", German for \"safety\", the -heit does not survive the translation intact.) \"Sturm\" is the German word for \"Storm\". Thus, with a little imagination, one can get \"Addle Storm\", or even \"Addling Storm\", out of her name; a fitting description given her fighting technique and a worthy pun that rivals the gil reward from The Miraculous Dale." },
    ['Adelinde']                         = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"The Brilioth Estate lies in the residential area. They are certainly the most notable family of dancers in these parts. They say the only daughter, Laila, is doing her dancer training now under the strict tutelage of her mother.\"" },
    ['Adjutant (Bastok)']                = { type = "Mission Associate", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Missions:\n* Crystal Fist I (B)\n* Crystal Fist II (B)\n* Crystal Fist III (B)\n* Crystal Fist IV (B)\n* Iron Anvil I (B)\n* Iron Anvil II (B)\n* Iron Anvil III (B)\n* Iron Anvil IV (B)" },
    ['Aged Stone, L.C.']                 = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "East Ronfaure (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of East Ronfaure (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Aloysius, I.M.']                   = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "La Vaule (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok has control of La Vaule (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation. *Campaign Sword in front of name during Campaign." },
    ['Angry Bull (S)']                   = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"The Galkan Bridge is currently closed to prevent infiltration by beastman spies.\"" },
    ['Annabelle']                        = { type = "Campaign Evaluator", icon = "TacticalAssessment.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* Annabelle provides evaluations for players aligned with the Fighting Fourth." },
    ['Antje']                            = { type = "Mission Associate", zones = { "Bastok (S)", "Ghoyu's Reverie" }, note = "Involved in Missions:\n* Storm's Crescendo" },
    ['Astrid, I.M.']                     = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Crawlers' Nest (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok has control of Crawlers' Nest (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Aurelius']                         = { type = "Citizen", zones = { "Bastok (S)", "Bastok Markets (S)" } },
    ['Bartholomaus']                     = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:* Can appear in all Campaign Battles for Bastok (S) as the leader of the 1st Iron Musketeers. :*Bartholomaus is among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Bastok regains most territory in their cordon. :* Uses Circle Blade for 200-600 damage, Vorpal Blade for 1400-3200 damage, Swift Blade for 900-1700, and his own unique AoE Weapon Skill called Glory Slash for 600-1300. :* Uses Mighty Strikes (can use more than once) and Warcry (every couple minutes). :* Talk: The Republic was formed with the blood and sweat of the people. The flames of freedom must continue to light our furnaces of strength. The waters of civilization must continue to turn our wheels of ingenuity! :* Battle Cry: You barbarians will regret the day you set foot on Bastokan soil!" },
    ['Bartholomaus Krueger']             = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Quelling The Storm\n* Honor Under Fire\n* Beneath the Mask\n\nNotes:\n\"The republic was formed with the blood and sweat of the people. The flames of freedom must continue to light our furnaces of strength. The waters of civilization must continue to turn our wheels of ingenuity!\"" },
    ['Benjamin']                         = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"The Allied Forces of Altana have been formed collectively by Jeuno and the three nations to combat the Beastmen Confederate. We've no business in an alliance with Windurst, if you ask me. Those Windurstians are not to be trusted. Am I the only one who remembers the Elshimo Campaign!?\"" },
    ['Bhio Fehriata']                    = { type = "Traveling Bard", icon = "PastEventWatcher.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* Will change your Title for a fee or can give you a random title for free. *For a full list of titles, which you can get with this NPC, see Titles." },
    ['Bhoratz']                          = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Cutscene", "Grauberg (S)" }, note = "Involved in Quests:\n* Message on the Wind" },
    ['Biggorf (S)']                      = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Light in the Darkness\n* Quelling The Storm\n\nNotes:\n\"The Galkan Bridge should be reopened immediately. I don't know what the president could be thinking. He claims to have roots in the miner's faction, but just what does he think of the Galka in the mining district? It is times like this when I wish that Talekeeper Raogrimm were still around to carry us through. It has been almost ten years since Raogrimm disappeared in the wintry cold of the north. We can only pray that he is still alive...somewhere.\"" },
    ['Blatherix']                        = { type = "Informant", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Light in the Darkness\n* Burden of Suspicion\n* Quelling The Storm\n\nNotes:\n(Initially) \"I'm a trader. You got anythin' to trade?\" (Later) \"I got all sortsa junk and gossip to trade. Keep me in mind next time you're in town.\"" },
    ['Blazing Lizard, L.C.']             = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Jugner Forest (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Jugner Forest (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Blingbrix']                        = { type = "Standard Merchant", icon = "StandardMerchant.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"Blingbrix good Gobbie from Boodlix's! Boodlix's Emporium help fighting fighters and maging mages. Gil okay, okay?\"" },
    ['Bottomless Gorge']                 = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"This is the Freidrich Battery. It bears the name of President Freidrich, our great leader during the First Battle of Konschtat. The battery has been reinforced with the finest Bastokan artillery to repel the siege of the beasthordes.\"" },
    ['Christoph']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"Senator Werner is adamant about having a technologically advanced military. He even goes so far as to visit the Metalworks from time to time. It seems Chief Engineer Cid is extremely busy after taking up the additional post as head of the Gunpowder Room.\"" },
    ['Clemens']                          = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"This facility is for the temporary imprisonment of beastmen prisoners of war. For your own safety, you are advised to keep your distance.\"" },
    ['Dancing Thunder, L.C.']            = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Sauromugue Champaign (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Sauromugue Champaign (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Darksteel Hurricane']              = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Cut Scenes Only", "Cutscene" }, note = "Involved in Quests:\n* Quelling the Storm\n\nNotes:\n* A notorious serial killer and political extremist from Bastok." },
    ['Derek Karst']                      = { type = "Republican Army", icon = "Dialogue.png", zones = { "Bastok (S)", "Cutscene", "Cutscenes" }, note = "Involved in Quests:\n* Storm on the Horizon\n* Fire in the Hole\n* Bonds of Mythril\n\nNotes:\n* Father of present day President Karst." },
    ['Detlef, I.M.']                     = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Beadeaux (S)" }, note = "Notes:\n* Bastok (S) affiliated Campaign Arbiter. Present when Bastok (S) has control of Beadeaux (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Dieter']                           = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Cutscene" }, note = "Involved in Quests:\n* Fires of Discontent\n* Burden of Suspicion\n* Storm on the Horizon\n* Fire in the Hole" },
    ['Drangord (S)']                     = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"Mining activities were forced to a halt when a squadron of Quadav seiged the entrance to the Palborough Mines. Not to say that mining day after day is a bag of laughs, but having no work at all is even worse. Maybe I'll volunteer for the Legion...\"" },
    ['Dunbaff']                          = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Light in the Darkness\n* Storm on the Horizon\n\nNotes:\n\"We Galka live some 200 years before setting off on our journey of rebirth. But none of us wish to embark on that journey now. Not with the fate of our nation, and world, so unsure.\"" },
    ['Eleonore']                         = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"I'm not quite sure why, but whenever I see a comet like that, it just puts a flutter in my chest.\"" },
    ['Elivira']                          = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:*Gold Musketeer Captain of the Department of Mining during the Crystal War. :*Shares her unique face-type with Mythril Musketeer Captain Klara. :* Can appear in all Campaign Battles for Bastok (S) as the leader of the 1st Gold Musketeers. :* Uses Split Shot for 200+ damage, Slug Shot for 1200-1400 damage, Heavy Shot for 800+ damage, and the Relic Weapon Skill Coronach for 800-1100 damage. She Weapon Skills frequently, usually attempting to self-Skillchain. :* Talk: The Metalworks' strategies are too timid for my taste. The beastmen are nothing but dominoes, waiting to be toppled. A swift, aggressive assault is the only way to victory. :* Battle Cry: A swift end is the only mercy you'll receive from me, fiends!" },
    ['Elivira Gogol']                    = { type = "Mythril Musketeer", icon = "Guard.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* Gold Musketeer Captain of the Department of Mining during the Crystal War. *Shares her unique face-type with Mythril Musketeer Captain Klara. \"The Metalworks' strategies are too timid for my taste. The beastmen are nothing but dominoes, waiting to be toppled. A swift, aggressive assault is the only way to victory.\"" },
    ['Else']                             = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:* Appears during Campaign Battles in Crawlers' Nest (S) as the leader of the 1st Legion Reiters :* Can cast Cure IV, Paralyze II, Slow II, Bindga, Stone III, and Blizzard III. :* Uses Penta Thrust, Skewer, and Impulse Drive. :* Her attacks have additional Effect: Petrification. :* Uses Chainspell. :* Uses Oppresive Embrace :* Talk: Have you ever stopped to ponder what that comet might truly portend? I'd like to believe it is a message of hope--that soon this age of darkness will come to a close... :* Battle Cry: This is your last chance. Throw down your weapons and your life will be spared. If you refuse..." },
    ['Engelhart']                        = { type = "Quest Associate", zones = { type = "Quest Associate", "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Better Part of Valor\n* Fires of Discontent\n* Burden of Suspicion" },
    ['Erik']                             = { type = "Notorious Monster", icon = "GoalTracker.png", zones = { "Bastok (S)", "The Eldieme Necropolis (S)" }, note = "Involved in Quests:\n* Lost in Translocation\n\nNotes:\n* No longer despawns. Quotes: \"There's all sorts of creepy things wandering around down here. Watch your back.\"" },
    ['Erlene']                           = { type = "Quest Giver", icon = "QuestGiver.png", zones = { "Bastok (S)", "The Eldieme Necropolis (S)" }, note = "Starts Quests:\n* A Little Knowledge\n* On Sabbatical\n* Downward Helix\n* Seeing Blood-red\n\nNotes:\n* Professor Erlene is an instructor of the Schultz School of Martial Theory, serving on the Operations Staff at the Eldieme Necropolis during the war. *Speak to her as a level 5+ Scholar to learn Embrava and Kaustra." },
    ['Ernestine']                        = { type = "Quest Associate", zones = { type = "Quest Associate", "Bastok (S)", "Bastok Markets (S)", "Cutscene" }, note = "Involved in Quests:\n* Burden of Suspicion" },
    ['Faltavie']                         = { type = "Map Vendor", icon = "MapDealer.png", zones = { "Bastok (S)", "Bastok Markets (S)" } },
    ['Feral Moon, L.C.']                 = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Vunkerl Inlet (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Vunkerl Inlet (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Field Musician Guard']             = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Pashhow Marshlands (S)" }, note = "Notes:\n* Participates in offensive Campaign Battles in Pashhow Marshlands, following Sonia. *They attack twice per combat round and occasionally Double Attack. *They can use all Hand-to-Hand weaponskills up to Howling Fist." },
    ['Field Woundpatcher']               = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S), North Gustaberg (S), Grauberg (S), Pashhow Marshlands (S), Crawlers' Nest (S), Rolanberry Fields (S)", "Battle" }, note = "Notes:\n:*Appears in Campaign battles along with another dispatched unit (except the 4th Legionnaire) in areas under Bastok's control; they never appear as a standalone unit. :*They will cast Blink, Phalanx, Stoneskin, Raise, and up to Protect IV, Shell IV, and Cure V on Campaign NPCs, anyone with Allied Tags on, and Beastmaster pets. Their spells seem to be on a timer, similar to Pixies. ::*The selection of spells they'll cast is dependent on conditions of the Republican Army of Bastok. Their capabilities can be augmented by doing the Cut and Cauterize (B) campaign ops. :*They will not attack unless attacked. When attacked, she'll draw her club and start attacking the aggressor. This will often happen in battles with monsters that use AoE attacks (such as Wrath of Gu'Dha). :*Has a finite MP pool, as of such will actually be seen in the Command/heal stance to recover MP and HP. You will often see them /heal after all Campaign mobs nearby are defeated and Campaign still continues because another wave is on the way. :*In the event that the unit they arrived with retreats, they will remain on the battlefield and not retreat, remaining to assist anyone nearby and to fight if attacked. :*Have low defence and HP compared to other Republican Army units, as of such they wont last long when attacked. :*Uses an ability called Goddess's Shield; this enables them to cast self-targeting spells like Blink and Phalanx on allied targets." },
    ['Five Moons']                       = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Bastok Markets (S) (Cutscene only)", "Cutscene" }, note = "Involved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* Burden of Suspicion\n* Storm on the Horizon\n* Fire in the Hole\n* Quelling the Storm\n* Honor Under Fire\n* Beneath the Mask\n* What Price Loyalty\n\nNotes:\n* His galkan name is Galagg." },
    ['Fridolin']                         = { type = "Campaign Allegiance", icon = "AllegianceChanger.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\nWill allow those who originally aligned to Bastok's campaign and later switched to other nations' campaign to return to Bastok for a price of 300 AN and the two highest campaign medals. Recompleting The Fighting Fourth is not required, or even possible." },
    ['Friedhold']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"Due to the encroaching threat of the Quadav Shieldwarriors, entry to Southern Gustaberg is currently prohibited. The republic appreciates your understanding.\"" },
    ['Gebhardt']                         = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "North Gustaberg (S)" }, note = "Involved in Quests:\n* The Fighting Fourth\n\nNotes:\n* Gebhardt is a Centurion of the Republic Legion stationed at the Eduard Watchtower. *Decurion Roderich at the Benedikt Watchtower is one of his subordinates." },
    ['Gentle Tiger (S)']                 = { type = "Campaign NPC", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Starts Quests:\n* Light in the Darkness\n* Burden of Suspicion\n* Honor Under Fire\n* What Price Loyalty\n\nInvolved in Quests:\n* Fires of Discontent\n* Storm on the Horizon\n* Fire in the Hole\n* Quelling The Storm\n* Beneath the Mask\n* On Sabbatical\n\nNotes:\nThe doorman for the Metalworks, and Zeid's number one fan. *This NPC will not appear if there is a campaign battle going on inside Bastok Markets (S). :\"The Metalworks have been placed under the jurisdiction of the military in order to develop and produce arms for the war. Neither townspeople nor low-ranking soldiers are permitted to enter.\"" },
    ['Granite Fist, L.C.']               = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Batallia Downs (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Batallia Downs (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Gray Colossus, L.C.']              = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Beaucedine Glacier (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok has control of Beaucedine Glacier (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Gumbah (S)']                       = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Cutscene" }, note = "Involved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* Storm on the Horizon\n* Fire in the Hole\n\nNotes:\n* Loyal friend and battle companion to Galkan elder Werei." },
    ['Helmfried']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"Before the onset of war, President Prien ralled the strong support of the Galkan citizenry. That was the key to his winning the election. But it seems his campaign promises of improving living standards have been complicated by the outbreak of hostilities.\"" },
    ['Herbert']                          = { type = "Quest Associate", zones = { type = "Quest Associate", "Bastok (S)", "Cutscene" }, note = "Involved in Quests:\n* Beneath the Mask" },
    ['Heumila']                          = { type = "Past Event Watcher", icon = "PastEventWatcher.png", zones = { "Bastok (S)", "Bastok Markets (S)" } },
    ['Hinrich']                          = { type = "Campaign Information", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\nPresents information on Bastok's current Campaign strategies and intel on the other 6 forces." },
    ['Hrichter Karst']                   = { type = "President", icon = "Dialogue.png", zones = { "Bastok (S)", "Cutscene", "Cutscenes" }, note = "Involved in Quests:\n* Burden of Suspicion\n* Bonds of Mythril\n\nNotes:\n* Younger version of current day Bastok president Karst. Senator Derek Karst is his father." },
    ['Invincible Shield (S)']            = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Involved in Missions:\n* Affairs of State\n\nNotes:\n:*Holds the title of 3rd Division's Legatus which makes him Commander in Chief of the 3rd Division/Legion of the Republican Army. :* Appears during Campaign Battles in North Gustaberg (S) and Bastok Markets (S) as the leader of the 3rd Legionnaire squadron. :* Uses Raging Axe for 600-1000 damage, Spinning Axe for 200-1300 damage, Rampage for 900-2600 damage, Decimation for 700-1700 damage, and his own unique slightly-ranged slightly-AoE Weapon Skill called Napalm Tomahawk for 200-1500 damage. :* Napalm Tomahawk can make Light skillchain with Fragmentation weaponskills (Shark Bite, Savage Blade, etc) :* Uses Mighty Strikes (can use more than once) and Warcry (every couple minutes). :* Talk: Halt! If you're not one of the Fourth, then get your sorry tail over to the recruitment office on the double! And if you are one of us, then what the hell are you doing here talking to me!? Get back on the battlefield! About...FACE! :* Battle Cry: I never liked fighting on land... Now give me a well armed battleship on the open sea, and I'll have those turtlebacks running for their lives! :* For some reason, it seems difficult/impossible to see Invincible Shield's damage against enemy leaders." },
    ['Isabella']                         = { type = "Survey", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* Supply Commander of the Fourth Division's Seventh Cohors. *Allows Bastok affiliated players to vote on future campaign tactics. \"600 loaves of iron bread...check. 15,000 copper bullets...check. Ah-- I am sorry, soldier, but my hands are tied at the moment. Could you return at a later date?\"" },
    ['Jagaris']                          = { type = "Armor Depository", icon = "ArmorStorer.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\nStores lvl 24-60 AF, Relic, RSE and other gearsets." },
    ['Jagged Onyx, L.C.']                = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "North Gustaberg (S)" }, note = "Notes:\n* Bastok (S) affiliated Campaign Arbiter. Present when Bastok (S) has control of North Gustaberg (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Jeremias']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "North Gustaberg (S)" }, note = "Involved in Quests:\n* Better Part of Valor\n\nNotes:\n* Seems to be a bodyguard of Senator Werner of the Republican Army during the Crystal War." },
    ['Johann, I.M.']                     = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Eldieme Necropolis (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Eldieme Necropolis (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Karlotte']                         = { type = "Item Deliverer", icon = "ItemDeliverer.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* Item Delivery services will not be available if the city is under attack. \"Do you have something you wish to send?\"" },
    ['Kasper']                           = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"When the beasthordes sieged San d'Oria, President Prien wasted no time in putting the entire republic on a wartime footing. In retrospect, it was certainly the right thing to do. If not for his unwavering leadership, we would most likely have begun the war well behind the already expanding beasthordes.\"" },
    ['Keenan']                           = { type = "ANNM Coordinator", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Starts Quests:\n* Allied Notes Notorious Monsters\n\nNotes:\n* Trade Allied Notes for ANNM Temp. Key Item Blue-Labeled Crate *1500 Allied Notes if from Bastok. *3000 Allied Notes if from another nation." },
    ['Kevan']                            = { type = "Sealed Container", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* Trade Sealed Containers to him to receive the corresponding key item for SCNM battle." },
    ['Klara']                            = { type = "Flavor NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S) (Cutscene only)", "Cutscene" }, note = "Starts Quests:\n* Quelling the Storm\n\nInvolved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* Burden of Suspicion\n* Storm on the Horizon\n* Fire in the Hole\n* Honor Under Fire\n* Beneath the Mask\n* What Price Loyalty\n* The Truth Lies Hid\n* Bonds of Mythril\n\nNotes:\n* Volker's predecessor as Captain of the The Mythril Musketeers during the Crystal War. *Shares her face-type with Elivira Gogol. *Her full name is Klara Bester." },
    ['Kurt']                             = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:* Can appear in all Campaign Battles for Bastok (S) as the leader of the 8th Iron Musketeers. :* Uses Tachi: Enpi for 500-1200+ damage, Tachi: Jinpu for 300-1500 damage, and his own unique AoE Knockback Weapon Skill called Iainuki for 500-1000 damage. Though he does not spam his Weapon Skills, sometimes he'll self-Skillchain Iainuki to Tachi: Jinpu, making Detonation. :* Spams Shuriken for 100-400 damage. :* Talk: Move along, soldier. I have nothing to say to you. :* Battle Cry: Watch carefully, because this is the last thing you'll ever see in this life! :* He has roughly 15000 HP." },
    ['Laurentia']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"There's a mining spot in Grauberg where you can dig up some very good quality crystals. Apparently the Quadav Shieldwarriors will stop at nothing to gain control of mining resources. That's the reason for the continuing conflict between them and republic.\"" },
    ['Layton']                           = { type = "Standard Merchant", icon = "StandardMerchant.png", zones = { "Bastok (S)", "The Eldieme Necropolis (S)" } },
    ['Lennart']                          = { type = "Item Deliverer", icon = "ItemDeliverer.png", zones = { "Bastok (S)", "The Eldieme Necropolis (S)" }, note = "Notes:\n* Item Delivery services are not available if The Eldieme Necropolis (S) is under beastman control or a campaign battle is occurring." },
    ['Lothur, I.M.']                     = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Castle Zvahl Keep (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok has control of Castle Zvahl Keep (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation. *Campaign Sword in front of name during Campaign." },
    ['Loussaire']                        = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Starts Quests:\n* Scholar's Loafers Quest\n* Scholar's Pants Quest\n* Scholar's Gown Quest\n\nNotes:\nLoussaire provides the following Scholar Artifact Armor upon completion of certain Side Quests: *Scholar's Loafers *Scholar's Pants *Scholar's Gown Note: *Player must be 50+ Scholar and complete Downward Helix to accept the side quest. *Disappears during Campaign Battles in the city." },
    ['Ludwig (S)']                       = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Involved in Missions:\n* | involved in quests\n\nNotes:\n:* Holds the title of 2nd Division's Legatus which makes him Commander in Chief of the 2nd Division/Legion of the Republican Army. :* Can appear in all Campaign Battles for Bastok (S) as the leader of the 2nd Legionnaire squadron. :* Can cast Bio III, Sleep II, Stun, Drain, Aspir, and the Absorb line of spells (eg. Absorb-VIT). :* Uses Guillotine for 1700-2600+ damage. :* His attacks have an Additional Effect: {{Dark|Darkness damage" },
    ['Ludwig Eichberg']                  = { type = "Campaign Leader", icon = "TacticalAssessment.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Missions:\n* Affairs of State\n\nNotes:\n* Holds the title of 2nd Division's Legatus which makes him Commander in Chief of the 2nd Division/Legion of the Republican Army. \"We may have the upper hand in technology and munitions, but the enemy's advantage lies in their sheer numbers. The Allied Campaign will not win in a day, soldier. Make every bullet count.\"" },
    ['Magdalena']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"I'll admit, I wasn't sure how things would turn out when Selbina suddenly declared its independence. Senator Werner dispatched the Republican Legion and took control of the situation with such incredible speed. Even the president himself was amazed by the senator's show of skill.\"" },
    ['Marianna, I.M.']                   = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Fort Karugo-Narugo (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Fort Karugo-Narugo (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Martina']                          = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Cutscene", "Ruhotz Silvermines" }, note = "Involved in Quests:\n* Fire in the Hole" },
    ['Matthias (S)']                     = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"I'm a huge fan of Laila's dancing! She's such an artist! Everyone agrees that she is a child prodigy. It's undeniable! Unfortunately, she's also famous for not signing autographs. Promise if you ever get one, you'll give it to me!\"" },
    ['Maximilian']                       = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:* Holds the title of 1st Division's Legatus which makes him Commander in Chief of the 1st Division/Legion of the Republican Army. :* Shares his unique face-type with Brandolf. :* Can appear in all Campaign Battles for Bastok (S) as the leader of the 1st Legionnaire squadron. :*Maximilian is among the few that may be dispatched to Beaucedine Glacier (S) and Xarcabard (S) once Bastok regains most territory in their cordon. :* Uses Circle Blade for 600-1100 damage, Vorpal Blade for 1500-3200 damage, and Swift Blade for 1100-2800 damage. He swings fast, with many Triple Attack and Critical hit procs. :* Uses Perfect Dodge. :* Talk: Turtle sleeps in a rocky den~'Cause he's not a citizen~Strike him down with sword and stave~Stick a blue flag in his grave~ :* Battle Cry: Ryaaaaaaaaah!" },
    ['Maximilian Berger']                = { type = "Campaign Leader", icon = "TacticalAssessment.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Missions:\n* Affairs of State\n\nNotes:\n*  Holds the title of 1st Division's Legatus which makes him Commander in Chief of the 1st Division/Legion of the Republican Army. \"Turtle sleeps in a rocky den~'Cause he's not a citizen~Strike him down with sword and stave~Stick a blue flag in his grave~\"" },
    ['Melina']                           = { type = "Chocobo Renter", icon = "ChocoboRenter.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Missions:\n* Magna Cache I (Bastok)\n* Magna Cache II (Bastok)\n* Magna Cache III (Bastok)\n\nNotes:\n* Must be level 20, have a Chocobo License,and be affiliated with one of the armies of the three nations to be eligible to rent a Chocobo. *Rental fees will be charged in Allied Notes rather than gil." },
    ['Millard, I.M.']                    = { type = "Sigil", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n:*Casts Sigil :*Sells items for Allied Notes (Bastok Campaign Items) at certain conditions. :*Explains the Campaign system by choosing some available questions. :*Tells you the remaining time on your current Sigil effect. For further information see Campaign Arbiter." },
    ['Minna']                            = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"Through this tunnel lie the Fourth Division barracks. While far from luxurious, the rooms provide troops with a place to store their belongings, receive packages, and rest up before missions.\"" },
    ['Nicolaus']                         = { type = "Mythril Musketeer", icon = "Guard.png", zones = { "Bastok (S)", "Bastok Markets (S) (Cutscene only)", "Cutscene" }, note = "Involved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* Burden of Suspicion\n* Storm on the Horizon\n* Fire in the Hole\n* On Sabbatical\n* Quelling the Storm\n* Honor Under Fire\n* Beneath the Mask\n* What Price Loyalty\n\nNotes:\nA member of the Mythril Musketeers during the Crystal War, and former student of Professor Schultz." },
    ['Nudara (S)']                       = { type = "Campaign NPC", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n* This NPC appears in the present and can be found at Nudara \"Things sure have taken a turn for the worse around here as of late. That's why everyone is closing up shop.\"" },
    ['Offa (S)']                         = { type = "Crystal War Quest", icon = "QuestNPC.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* A Proper Burial" },
    ['Pagdako']                          = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* The Doorman (Flashback)\n\nNotes:\n\"Elder Werei is teaching me the art of swordfighting. One day, I'll be just as good as Sir Raogrimm!\"" },
    ['Pale Eagle']                       = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Cutscene" }, note = "Involved in Quests:\n* Burden of Suspicion\n* Storm on the Horizon\n\nNotes:\nChairman Pale Eagle is a senior member of the republican government, appointed to his position by President Prien himself. During his military days, he was known as the \"Eagle of Grauberg\"." },
    ['Paul']                             = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Quelling The Storm\n\nNotes:\n\"You've heard what they say, that the heat of combat will make you see things you've never seen before? It's true... In battle I saw a...horrific monster. Not like any of the other beastmen. Covered in mangy black and white fur... At first, I thought it was some kind of wicked Mithra. But no... That was no Mithra!\"" },
    ['Polished Fang, L.C.']              = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Grauberg (S)" }, note = "Notes:\n* Bastok (S) affiliated Campaign Arbiter. Present when Bastok (S) has control of Grauberg (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Pondering Peak, L.C.']             = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Meriphataud Mountains (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Meriphataud Mountains (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Prien']                            = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Cutscene" }, note = "Involved in Quests:\n* Fires of Discontent\n* Burden of Suspicion\n* Fire in the Hole\n* Quelling the Storm\n* Honor Under Fire\n* What Price Loyalty\n\nInvolved in Missions:\n* Affairs of State\n\nNotes:\n* The President of the Republic of Bastok during the Crystal War." },
    ['Professor Schultz']                = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Cutscene" }, note = "Starts Quests:\n* Survival of the Wisest\n\nInvolved in Quests:\n* A Little Knowledge\n* On Sabbatical\n* Seeing Blood-red\n\nNotes:\nThe legendary Bastokan military tactician who served in the Second Battle of Konschtat, and founder of the Gunther Schultz School of Martial Theory.See Gunther for NM version. {{spoiler3" },
    ['Radford']                          = { type = "Mission Associate", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Missions:\n* Affairs of State" },
    ['Raginmund']                        = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Quests:\n* Too Many Chefs\n* (This NPC is only present when there is no Campaign Battle.)\n\nNotes:\n\"I hear lots of people saying they wish they hadn't been born to witness such dark and troubled days. But I, for one, am glad I'm alive to witness this war. Undoubtedly there are hardships to be endured, but this is a heroic battle that will surely live on in our histories! I would count myself blessed to be able to see it through to completion!\"" },
    ['Rainer']                           = { type = "Quest Associate", zones = { type = "Quest Associate", "Bastok (S)", "Cutscene" }, note = "Involved in Quests:\n* Beneath the Mask" },
    ['Red Axe']                          = { type = "Quest Associate", zones = { type = "Quest Associate", "Bastok (S)", "The Eldieme Necropolis (S)" }, note = "Involved in Quests:\n* Beneath the Mask" },
    ['Red Canyon (S)']                   = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"Port Bastok is strictly off-limits to all but authorized personnel. However, if you wish to travel to North Gustaberg, you may use the Republic's supply causeway. Cross the bridge?\"" },
    ['Republic Supplier']                = { type = "Campaign Battle", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Battle", "Varies" }, note = "Notes:\n* Appears during an offensive campaign against Beastman territories. Up to 3 suppliers may be present at a time. *Distributes temporary items to players allied with Bastok in the battle. *Upon the depletion of their stock, these distributors will temporarily return to headquarters in order to replenish their stores. *They will take defensive action against aggressors, but during that time they will be unable to dispense items. Should they become incapacitated in the course of battle, a replacement will be dispatched after a certain amount of time has elapsed. *Item availability and quantity is directly influenced by each nation's skill and production levels." },
    ['Roaring Badger']                   = { type = "Mission Associate", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Involved in Missions:\n* Bridge Too Far I (Bastok)" },
    ['Rolf']                             = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"This here's a useful chocobo as you'll ever see. Capable of anything from battle mount to messenger chocobo!\"" },
    ['Ruediger, I.M.']                   = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Garlaige Citadel (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of Garlaige Citadel (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Rusted Musket']                    = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n\"At the battle of Vunkerl Inlet, the Republican Legion's Third Division encountered a gigas raiding party approaching by sea. The fiends eventually made landfall, but their advance was stopped cold by the brilliant tactics of Legatus Invincible Shield. No doubt his military genius will become the stuff of legend!\"" },
    ['Scarred Shark']                    = { type = "Dialogue NPC", icon = "Dialogue.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Starts Quests:\n* Hammering Hearts\n\nNotes:\n\"Do you know what a Sahagin is? You know, those fish-like beastmen. Their demolition tactics have reduced Port Bastok to a shadow of its former glory. The Third Division of the Republican Legion is working tirelessly to rebuild it. And the crushing defeat at Grauberg left even the Fourth Division nearly annihilated. At this rate, who knows what will become of our Republic...\" His galkan name is Vareggo." },
    ['Shenni']                           = { type = "Trust Coordinator", icon = "Trust.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Special Event" }, note = "Notes:\n* Shenni only appears at ({{Location Tooltip|area=Bastok Markets (S)|pos=F-9" },
    ['Silke']                            = { type = "Standard Merchant", icon = "StandardMerchant.png", zones = { "Bastok (S)", "Bastok Markets (S)" }, note = "Notes:\n*  Remains available during Campaign Battles." },
    ['Sonia']                            = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:* Uses Trance. :* Appears during Campaign Battles in Pashhow Marshlands (S) as the leader of the Field Musician Guard. :* Uses all Hand-to-Hand weaponskills including Asuran Fists. :* Very low delay attacks and very high critical hit rate with an Additional Effect: Stun. :* Sonia will use all Dancer abilities, including Reverse Flourish if needed. :* Uses a dance called 'Reverie Frolic', which gives all hostile targets in range the effect of Dia, Accuracy Down, and Magic Accuracy Down. :* Talk: You look like you've seen better days, soldier. Let me guess, it's the war that's bringing you down. What you need is a little music in your life! :* Battle Cry: To your seats, boys! The show is about to begin!" },
    ['Stray Boar, L.C.']                 = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Pashhow Marshlands (S)" }, note = "Notes:\n* Bastok (S) affiliated Campaign Arbiter. Present when Bastok (S) has control of Pashhow Marshlands (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Striking Bull']                    = { type = "Campaign Battle Ally", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Bastok Markets (S)", "Battle" }, note = "Notes:\n:* Appears during Campaign Battles in Rolanberry Fields (S) as captain of the 2nd Legion Grenadiers. :* Has a very low attack delay. :* Stands back and spams Mistral Axe for 400-800 damage; however, sometimes he ends up standing there and not doing anything. He can also use Smash Axe for 200+ damage, Gale Axe for 200+ damage, Avalanche Axe for 200+ damage, Calamity for 300-600 damage, and Decimation for up to 500 damage. :* Uses Bloody Tomahawk ability approximately every 20 seconds for 100-500 damage. :* Talk: If it weren't for the Galkan heavy infantry, this nation wouldn't last a month against the turtlebacks. And what thanks do we get? A handful of stale army biscuits! :* Battle Cry: Ahahahaha! My hand slipped! :* For some reason, it seems difficult/impossible to see Striking Bull's damage against enemy leaders." },
    ['Tenacious Fool, L.C.']             = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "West Sarutabaruta (S)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok (S) has control of West Sarutabaruta (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Thorben']                          = { type = "Quest Giver", zones = { "Bastok (S)", "Batallia Downs (S)" }, note = "Starts Quests:\n* Lost in Translocation" },
    ['Timid Scorpion, L.C.']             = { type = "Campaign", icon = "CampaignArbiter.png", zones = { "Bastok (S)", "Xarcabard (S), (?-?)" }, note = "Notes:\n* Bastok affiliated Campaign Arbiter. Present when Bastok has control of Xarcabard (S). *Offers Campaign Information, Campaign Allied Tags, Teleportation *Campaign Sword in front of name during Campaign" },
    ['Turbulent Storm']                  = { type = "Pixie Recruiter", icon = "Dialogue.png", zones = { "Bastok (S)", "The Eldieme Necropolis (S)" }, note = "Involved in Quests:\n* The Fighting Fourth\n\nInvolved in Missions:\n* Back to the Beginning\n\nNotes:\nAnswer \"Sign me up!\" to his question about chasing Pixies to receive a {{KeyItem" },
    ['Ulbrecht']                         = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Bastok (S)", "Cutscene" }, note = "Involved in Quests:\n* A Little Knowledge\n* On Sabbatical\n* Downward Helix\n* Seeing Blood-red\n\nNotes:\nProfessor Ulbrecht is an officer schooled in the Schultz School of Martial Theory. He is somewhat crass and uncivil, sometimes interrupting Professor Erlene with requests." },
    ['Volker (S)']                       = { type = "Mythril Musketeer", icon = "Guard.png", zones = { "Bastok (S)", "Cutscene", "Cutscenes" }, note = "Involved in Quests:\n* Fires of Discontent\n* Light in the Darkness\n* Burden of Suspicion\n* Storm on the Horizon\n* Fire in the Hole\n* Quelling the Storm\n* Honor Under Fire\n* What Price Loyalty\n* The Truth Lies Hid\n* Bonds of Mythril" },
