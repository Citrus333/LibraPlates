    ['Najelith']                         = { type = "Serpent General", icon = "Guard.png", zones = { "Al Zahbi" }, note = "Involved in Quests:\n* When the Bow Breaks\n* Soothing Waters\n* Embers of His Past\n\nNotes:\n*  Najelith is one of five Serpent Generals defending Al Zahbi during Besieged. She holds the title Galeserpent General and is a Hume Ranger. *She must be in Al Zahbi in order to complete the quest When the Bow Breaks. If she is held prisoner, the quest cannot be completed until she is rescued." },
    ['Nareema']                          = { type = "Azouph Assault", icon = "AssaultMissionGiver.png", zones = { "Al Zahbi", "Azouph Isle Staging Point (Caedarva Mire" }, note = "Involved in Quests:\n* Beginnings\n\nInvolved in Missions:\n* Immortal Sentries\n* Azure Experiments\n\nNotes:\n* Speak with her to receive an Assault Armband for assault missions in Leujaoam Sanctum. Quote: \"Blue...muddies the purest waters.\" \"It is the mark of the blue mage...\" \"You and I...\" \"The color of our blood...our souls...the same...\" \"I cannot bear it... Cannot...\" \"I was free...\" \"You have lost your freedom...\" \"Leave me be... I cannot bear it...\"" },
