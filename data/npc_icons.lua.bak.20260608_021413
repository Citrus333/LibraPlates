    ['Unlucky Rat']                      = { type = "Scroll Quest", icon = "QuestNPC.png", zones = { "Bastok", "Metalworks" }, note = "Starts Quests:\n* Mean Machine" },
    ['Vaghron']                          = { type = "Adventurer's Assistant", icon = "AdventurersAssistant.png", zones = { "Bastok", "Bastok Mines" }, note = "Involved in Quests:\n* Lure of the Wildcat (Bastok)\n\nNotes:\nthumb|Monsters Offers Information on Monster Relationships: :What do you want? Oh, you think that because I'm just a kid you can walk over and talk to me for no good reason? True, I might look like a child now, but I know I was once a great warrior, and I can prove it. Do you want to see proof? :*\"Yes.\": I thought so. Well...all right, here. But be careful! It's very, very valuable--it's a piece of my past life. A friend gave this to me over twenty years ago. I can't remember what it all means, though. I showed this to my friend Gumbah once, and his opinion was that this is a very valuable document that tells you each monster type's weakness. He said it will come in handy when I become an adventurer. You've been a good pupil. Come back anytime if you want to see it again. Well, at least until I leave on my first adventure... :*\"No.\": I wasn't going to show you anyway. I know your type. Patting kids on the head and thinking how great life was when you were their age, right? Spare me, please." },
    ['Valah Molkot']                     = { type = "Adventurer's Assistant", icon = "AdventurersAssistant.png", zones = { "Bastok", "Port Bastok" }, note = "Starts Quests:\n* A Lady's Heart\n\nNotes:\nOffers Information on Gardening: :Hey therrre miss/mister! Have you heard? Have you? :*\"What are you talking about?\": Do you rrreally wanna know? Really? Really? Listen! I know the secrets of gar-den-ing. What do you wanna know? What do you wanna know? :::*\"What is gardening?\": Take a seed, plant it in a flowerpot, and leave the rest to your moogle! That's garrrdening! Then, after a while, a prrretty flower blooms! And then, and then the flower turrrns into fruit, and you can get all kinds of neat stuff! (She stares off into the distance) Oops! I was just thinking about all that delicious fruit. Purrrrrr... :::*\"What do I need to start?\": Um, okay, to start off, you're gonna need a flowerrrpot and some seeds. You can buy flowerrrpots in town, but you're gonna have to go out and get your seeds from the plant-monstersrr. And then guess what! Guess! Guess! Give your plant a crrrystal and its frrruit will change! Really! (She stares off into the distance) Oh! I was just thinking about all the different kinds of fruit and...Purrrrrr... :::*\"How do I garden?\": You can sit back, relax and do all your garrrdening in your Mog House! All you have to do is tell him what to do, and your moogle will do all the worrrk! But make sure you check up on your plant sometimes, or it might... (She looks a little sad) Well, just check up on your plant every now and then, okay? Prrromise? Even if you're off on an adventurrre somewhere, your moogle will use special powerrrs to take care of your plant! Moogles are so cool! :::*\"Are there any limits?\": Um, um, I think you can have up to ten plants in yourrr room. Any morrre and your moogle won't be able to handle it! They're rrreally busy, you know! And... Oh, yeah! You have to put your seeds and flowerpots in your Mog Safe beforrre you can use 'em! They need to be in therrre so your moogle ca use his magic on 'em! Moogles are awesome! :::*\"Bye-bye!\": Meowww... :*\"Yes, I have!\": Reoooow. Well, I guess I don't have to tell you, then." },
    ['Valentione Single']                = { type = "Special Event", icon = "SpecialEventCoordinator.png", zones = { "Bastok", "San d'Oria", "San d'Oria :*Male Hume - Southern San d'Oria", "Special Event", "Windurst" }, note = "Notes:\nThey appear when the special event Valentione's Day is active. ;Notes: :*There are 8 Valentione Singles in each town - One for each race and gender. :*Each gender have 4 different personalities: Honest, cheerful, modest/cool-headed and shy. :*They all feel more or less lonely and it's your task to help them out by trading chocolate hearts and finding a partner. :*The success of your work determines whether you get a Charm Wand or a Charm Wand +1. For detailed information, see Valentione's Day." },
