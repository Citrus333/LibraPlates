    ['Nag\'molada']                     = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Jeuno", "Ru'Lude Gardens" }, note = "Involved in Quests:\n* Apocalypse Nigh\n\nInvolved in Missions:\n* Promathia Mission 1-1: The Rites of Life\n* Promathia Mission 1-2: Below the Arks\n* Promathia Mission 1-3: The Mothercrystals\n* Promathia Mission 2-1: An Invitation West\n* Promathia Mission 2-2: The Lost City\n* Promathia Mission 2-3: Distant Beliefs\n* Promathia Mission 2-4: An Eternal Melody\n* Promathia Mission 2-5: Ancient Vows\n* Promathia Mission 3-2: Vessel Without a Captain\n* Promathia Mission 3-4: Tending Aged Wounds\n* Promathia Mission 4-2: The Savage\n* Promathia Mission 5-1: The Enduring Tumult of War\n* Promathia Mission 5-2: Desires of Emptiness\n* Promathia Mission 5-3: Three Paths\n* The Pursuit of Paradise (Tenzen's Path)\n* Promathia Mission 6-1: For Whom the Verse is Sung\n* Promathia Mission 6-2: A Place to Return\n* Promathia Mission 6-4: One to be Feared\n* Promathia Mission 7-5: The Warrior's Path\n* Promathia Mission 8-1: The Garden of Antiquity\n* Promathia Mission 8-2: A Fate Decided\n* Promathia Mission 8-3: When Angels Fall\n\nNotes:\nNag'molada is a diplomat for the Duchy of Jeuno, and a member of the Armathrwn Society. In the time of the Great War, he was employed by the Archduke as a special envoy to the other three nations, and assisted in the formation of the Allied Forces of Altana. He has an exceptional grasp of strategy and is highly skilled in negotiations." },
    ['Nag\'molada (S)']                 = { type = "Cutscene NPC", icon = "Cutscene.png", zones = { "Cutscene", "Jeuno (S)" }, note = "Involved in Quests:\n* Downward Helix (SCH AF2)\n* Seeing Blood-red (SCH AF3)\n\nInvolved in Missions:\n* A Spoonful of Sugar (WOTG11)\n* Borne by the Wind (WOTG13)\n* A Nation on the Brink (WOTG14)\n* Crossroads of Time (WOTG15)\n\nNotes:\nA member of the Armathrwn Society, serving as an agent of Archduke Kam'lanaut during the Crystal War. He spearheaded an investigation into the mass disappearances of numerous military scholars." },
