local function FormatModifierPercent(potency)
    potency = tonumber(potency) or 1;

    if (potency > 1) then
        return '+' .. tostring(math.floor(((potency - 1) * 100) + 0.5)) .. '%';
    end

    return '-' .. tostring(math.floor(((1 - potency) * 100) + 0.5)) .. '%';
end

