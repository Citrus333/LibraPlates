    ['Ragelise']                         = { type = "Mission", icon = "MissionNPC.png", zones = { "Cutscene", "San d'Oria (S)" }, note = "Involved in Missions:\n* WOTG04: The Queen of the Dance\n* WOTG05: While the Cat is Away\n* WOTG06: A Timeswept Butterfly\n* WOTG07: Purple, The New Black\n* WOTG08: In the Name of the Father\n* WOTG09: Dancers in Distress\n* WOTG11: A Spoonful of Sugar\n* WOTG14: A Nation on the Brink\n* WOTG20: On Thin Ice\n* WOTG25: The Will of the World\n\nNotes:\n* Sir Ragelise B Baloumat is the captain of the Knights of the Ironcrest Hawk. His order attempted to assist the Knights of the Madder Falcon in retaking La Vaule from the Orcish Hosts." },
    ['Rahal (S)']                        = { type = "Campaign Leader", icon = "TacticalAssessment.png", zones = { "Cutscene", "San d'Oria (S)", "Southern San d'Oria (S)" }, note = "Involved in Quests:\n* Gifts of the Griffon\n* Claws of the Griffon\n* Boy and the Beast\n* Wrath of the Griffon\n* Perils of the Griffon\n* In a Haze of Glory\n\nNotes:\n* Excenmille's second in command of the Young Griffons." },
