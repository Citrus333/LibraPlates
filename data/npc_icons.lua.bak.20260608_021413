    ['Karst']                            = { type = "President", icon = "Dialogue.png", zones = { "Bastok", "Metalworks" }, note = "Involved in Quests:\n* Waking the Colossus\n\nInvolved in Missions:\n* Bastok Mission 2-3: The Emissary\n* Bastok Mission 5-1: Darkness Rising\n* Bastok Mission 5-2: Xarcabard, Land of Truths\n* Bastok Mission 7-2: On My Way\n* Bastok Mission 9-2: Where Two Paths Converge\n* A Crystalline Prophecy (Mission)\n\nNotes:\nPresident of the Republic of Bastok, and a controversial figure among many in the Republic. It is said that he only won his position due to the support of Cid. He is the father of Cornelia. Present version of Hrichter Karst. Derek Karst is his father." },
