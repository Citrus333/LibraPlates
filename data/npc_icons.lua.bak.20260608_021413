    ['Coderiant']                        = { type = "Adventurer's Assistant", icon = "AdventurersAssistant.png", zones = { "San d'Oria", "Southern San d'Oria" }, note = "Involved in Quests:\n* Lost Chick\n\nNotes:\nOffers Directions Around Town: :Are you lost? I know this neighborhood well. Which way are you going? :*\"Left.\": There on Pikeman's Way you can find a grocer, sundries and the Tanners' Guild. At the end lies the mansion of Count Caffaule. :*\"Right.\": Go up those stairs for Watchdog Alley. Homes of townsfolk line the street." },
